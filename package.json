{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "nikcli",
  "description": "AI-powered development tool",
  "private": false,
  "type": "module",
  "version": "1.129.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --cwd packages/nikcli --conditions=browser src/index.ts",
    "typecheck": "bun turbo typecheck",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "hello": "echo 'Hello World!'",
    "test": "echo 'do not run tests from root' && exit 1",
    "web:dev": "bun run --cwd packages/web dev",
    "web:preview": "bun run --cwd packages/web dev",
    "webgui:dev": "bun run --cwd packages/app dev",
    "webgui:build": "bun run --cwd packages/app build",
    "desktop:dev": "bun run --cwd packages/desktop native:dev",
    "desktop:build": "bun run --cwd packages/desktop native:build"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/console/*",
      "packages/remote",
      "packages/sdk/js",
      "packages/slack",
      "github"
    ],
    "catalog": {
      "@types/bun": "1.3.7",
      "@octokit/rest": "22.0.0",
      "@hono/zod-validator": "0.4.2",
      "ulid": "3.0.1",
      "@kobalte/core": "0.13.11",
      "@types/luxon": "3.7.1",
      "@types/node": "22.13.9",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@cloudflare/workers-types": "4.20251008.0",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@pierre/diffs": "1.0.2",
      "@solid-primitives/storage": "4.3.3",
      "@tailwindcss/vite": "4.1.11",
      "diff": "8.0.2",
      "dompurify": "3.3.1",
      "ai": "5.0.173",
      "hono": "4.10.7",
      "hono-openapi": "1.1.2",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "marked": "17.0.1",
      "marked-shiki": "1.2.1",
      "@playwright/test": "1.51.0",
      "typescript": "5.8.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "zod": "4.1.8",
      "remeda": "2.26.0",
      "shiki": "3.20.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.1.11",
      "virtua": "0.42.3",
      "vite": "7.1.4",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "solid-js": "1.9.10",
      "vite-plugin-solid": "2.11.10"
    }
  },
  "devDependencies": {
    "@actions/artifact": "5.0.1",
    "@tsconfig/bun": "catalog:",
    "husky": "9.1.7",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "prettier": "3.8.4",
    "semver": "^7.6.0",
    "sst": "3.19.3",
    "turbo": "2.9.18"
  },
  "dependencies": {
    "@astrojs/check": "0.9.6",
    "@aws-sdk/client-s3": "3.933.0",
    "@nikcli-ai/plugin": "workspace:*",
    "@nikcli-ai/script": "workspace:*",
    "@nikcli-ai/sdk": "workspace:*",
    "@opentui/core": "0.1.95",
    "@parcel/watcher": "2.5.1",
    "@slack/bolt": "4.6.0",
    "@types/bun": "1.3.7",
    "@vercel/sandbox": "1.10.0",
    "cli-sound": "1.1.3",
    "expo-image": "55.0.10",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nikomatt69/nikcli"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "web-tree-sitter"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  },
  "patchedDependencies": {
    "@ff-labs/fff-bun@0.9.4": "patches/@ff-labs%2Ffff-bun@0.9.4.patch",
    "@openrouter/ai-sdk-provider@1.5.4": "patches/@openrouter%2Fai-sdk-provider@1.5.4.patch",
    "ghostty-web@0.3.0": "patches/ghostty-web@0.3.0.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "expo-modules-jsi@56.0.9": "patches/expo-modules-jsi@56.0.9.patch"
  }
}
