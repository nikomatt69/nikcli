{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nikcli-ai/sdk",
  "version": "0.0.7",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "./script/build.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./crypto": "./src/crypto/index.ts",
    "./cloud": "./src/cloud/index.ts",
    "./v2": "./src/v2/index.ts",
    "./v2/client": "./src/v2/client.ts",
    "./v2/server": "./src/v2/server.ts"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.4",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  },
  "dependencies": {},
  "publishConfig": {
    "directory": "dist",
    "exports": {
      ".": "./index.js",
      "./client": "./client.js",
      "./server": "./server.js",
      "./crypto": "./crypto/index.js",
      "./cloud": "./cloud/index.js",
      "./v2": "./v2/index.js",
      "./v2/client": "./v2/client.js",
      "./v2/server": "./v2/server.js"
    }
  }
}