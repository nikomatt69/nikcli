{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    // Required since TypeScript 7: rootDir is no longer inferred when emitting (TS5011).
    "rootDir": "src",
    "module": "preserve",
    "declaration": true,
    "moduleResolution": "bundler",
    "target": "es2022",
    "downlevelIteration": true,
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": ["src"]
}
