{
  "name": "@nikcli-ai/native-control",
  "version": "1.188.0",
  "private": true,
  "description": "Persistent control, inspection, and verification for native nikcli interfaces",
  "license": "MIT",
  "type": "module",
  "bin": {
    "native-control": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "control": "bun src/cli.ts",
    "install-skill": "bun src/cli.ts install-skill",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "native:check": "cargo check --manifest-path native-host/Cargo.toml --locked",
    "native:run": "cargo run --manifest-path native-host/Cargo.toml --"
  },
  "dependencies": {
    "@nikcli-ai/native-ui-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
