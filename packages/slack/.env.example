# Slack Bot Credentials
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# nikcli model (default: minimax-coding-plan/MiniMax-M2.5)
NIKCLI_MODEL=minimax-coding-plan/MiniMax-M2.5

# Optional: comma-separated channel IDs the bot is allowed in
SLACK_ALLOWED_CHANNELS=

# Rate limit per user (requests per minute, default 200)
SLACK_RATE_LIMIT_PER_USER=200

# Post tool-use updates into threads (default true)
SLACK_TASK_NOTIFICATIONS=true

# Bot display name
SLACK_USERNAME=NikCLI Bot

# Health server port
HEALTH_PORT=3000

# Worker mode only
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NIKCLI_URL=
NIKCLI_USERNAME=
NIKCLI_PASSWORD=
OPENAI_API_KEY=

# --- Claude Tag features (Socket Mode / src/index.ts) ---
# Per-channel memory (default on; set false to disable)
SLACK_CHANNEL_MEMORY=true
SLACK_CHANNEL_MEMORY_SIZE=12
# Autonomous follow-ups (default on)
SLACK_FOLLOWUPS=true
SLACK_FOLLOWUP_SLOW_MS=120000
SLACK_FOLLOWUP_DONE_MS=20000
# Per-channel tool policy ("bash=false,write=false" defaults; admin user IDs)
SLACK_DEFAULT_TOOLS=
SLACK_ADMIN_USERS=
# Persistence paths
# Leave these unset to use the OS temp directory (cross-platform default).
# Uncomment + override to pin a specific location.
# CHANNEL_MEMORY_FILE=path/to/slack-channel-memory.json
# CHANNEL_TOOLS_FILE=path/to/slack-channel-tools.json
# SESSIONS_FILE=path/to/slack-sessions.json
