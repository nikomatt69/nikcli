# Slack Bot Credentials
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# nikcli model (default: minimax-coding-plan/MiniMax-M2.5)
NIKCLI_MODEL=minimax-coding-plan/MiniMax-M2.5

# Optional: comma-separated channel IDs the bot is allowed in
SLACK_ALLOWED_CHANNELS=

# Rate limit per user (requests per minute, default 200)
SLACK_RATE_LIMIT_PER_USER=200

# Post tool-use updates into threads (default true)
SLACK_TASK_NOTIFICATIONS=true

# Bot display name
SLACK_USERNAME=NikCLI Bot

# Health server port
HEALTH_PORT=3000

# Worker mode only
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NIKCLI_URL=
NIKCLI_USERNAME=
NIKCLI_PASSWORD=
OPENAI_API_KEY=
