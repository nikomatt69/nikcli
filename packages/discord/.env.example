# Discord Bot Credentials
DISCORD_BOT_TOKEN=

# Optional: application id (derived from the token via users/@me if unset)
# DISCORD_CLIENT_ID=

# nikcli model (default: minimax-coding-plan/MiniMax-M2.5)
# NIKCLI_MODEL=minimax-coding-plan/MiniMax-M2.5

# Optional: comma-separated channel IDs the bot is allowed in
# DISCORD_ALLOWED_CHANNELS=

# Rate limit per user (requests per minute, default 2000)
# DISCORD_RATE_LIMIT_PER_USER=2000

# Post tool-use updates into threads (default true)
# DISCORD_TASK_NOTIFICATIONS=true

# Health server port (CLI process only)
# HEALTH_PORT=3000

# Remote nikcli server (when unset, a local server is started)
# NIKCLI_URL=
# NIKCLI_USERNAME=
# NIKCLI_PASSWORD=
# NIKCLI_WORKDIR=
# NIKCLI_DIRECTORY=

# Voice transcription (Whisper via OpenRouter)
# OPENROUTER_API_KEY=
# WHISPER_MODEL=openrouter/openai/whisper-1
# WHISPER_LANGUAGE=

# --- Claude Tag features ---
# Per-channel memory (default on; set false to disable)
# DISCORD_CHANNEL_MEMORY=true
# DISCORD_CHANNEL_MEMORY_SIZE=12
# Autonomous follow-ups (default on)
# DISCORD_FOLLOWUPS=true
# DISCORD_FOLLOWUP_SLOW_MS=120000
# DISCORD_FOLLOWUP_DONE_MS=20000
# Per-channel tool policy ("bash=false,write=false" defaults; admin user IDs)
# DISCORD_DEFAULT_TOOLS=
# DISCORD_ADMIN_USERS=
# Persistence paths
# CHANNEL_MEMORY_FILE=/tmp/discord-channel-memory.json
# CHANNEL_TOOLS_FILE=/tmp/discord-channel-tools.json
# SESSIONS_FILE=/tmp/discord-sessions.json
