{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nikcli-ai/plugin",
  "version": "0.0.5",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "tsc"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tool": "./src/tool.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./tool": "./dist/tool.js",
      "./tui": "./dist/tui.js"
    }
  },
  "dependencies": {
    "@nikcli-ai/sdk": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
