{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    // Required since TypeScript 7: rootDir is no longer inferred when emitting (TS5011).
    "rootDir": "src",
    "module": "preserve",
    "declaration": true,
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": ["src"]
}
