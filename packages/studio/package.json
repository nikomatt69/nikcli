{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nikcli-ai/studio",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:server": "bun run src/server/index.ts",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && wrangler pages deploy dist --commit-dirty=true"
  },
  "exports": {
    "./server": "./src/server/index.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@nikcli-ai/sdk": "workspace:*",
    "@nikcli-ai/ui": "workspace:*",
    "@nikcli-ai/util": "workspace:*",
    "@solidjs/router": "catalog:",
    "@solidjs/meta": "catalog:",
    "solid-js": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@types/yaml": "^1.9.7",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "bun-types": "1.3.7"
  }
}