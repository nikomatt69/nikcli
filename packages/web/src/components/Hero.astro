---
---

<section class="page-section relative overflow-hidden flex min-h-[82vh] flex-col justify-center pt-20 sm:pt-24 md:min-h-[88vh] md:pt-28">
  <!-- Dynamic Background Glow & Noise -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-terminal-accent/10 dark:bg-terminal-accent/15 blur-[120px] rounded-full pointer-events-none -z-10 animate-pulse-slow mix-blend-screen"></div>

  <div class="page-shell relative z-10">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center animate-fade-in-up">
      
      <!-- Pill Badge -->
      <a href="/docs" class="mb-8 inline-flex items-center gap-2 rounded-full border border-terminal-border bg-surface-hover px-3.5 py-1.5 text-[13px] font-semibold text-terminal-text shadow-sm transition-all duration-300 group hover:bg-terminal-panel hover:shadow-soft active:scale-95 sm:mb-10">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-terminal-accent opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-terminal-accent"></span>
        </span>
        <span class="text-terminal-muted group-hover:text-terminal-text transition-colors">Nikcli is now open source</span>
        <svg class="w-4 h-4 text-terminal-muted group-hover:text-terminal-text group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
      </a>

      <!-- Headline -->
      <h1 class="mb-6 text-[2.75rem] font-black leading-[1.03] tracking-[-0.03em] text-terminal-text drop-shadow-sm sm:mb-8 sm:text-[4rem] md:text-[5rem]">
        Your AI Development
        <br />
        <span class="bg-gradient-to-r from-terminal-accent via-teal-400 to-blue-500 bg-clip-text text-transparent relative">
          Partner
          <!-- Subtle highlight behind the gradient text -->
          <span class="absolute inset-x-0 bottom-0 h-[20%] bg-terminal-accent/10 blur-xl -z-10"></span>
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="mb-10 max-w-2xl text-base font-medium leading-relaxed text-terminal-muted sm:text-lg md:mb-12 md:text-xl">
        Open source. Provider agnostic. Built for developers who demand absolute perfection from their terminal tools.
      </p>

      <!-- Terminal Window (Hyper-Polished) -->
      <div class="group relative mx-auto mb-12 w-full max-w-[min(100%,52rem)] overflow-hidden rounded-[var(--radius-card)] border border-terminal-window-border/80 bg-terminal-window-bg text-left shadow-strong transition-transform duration-500 hover:scale-[1.01] hover:shadow-glow dark:border-white/10 md:mb-14">
        
        <!-- Terminal Header -->
        <div class="flex items-center justify-between border-b border-terminal-window-border/60 bg-gradient-to-b from-surface-hover to-terminal-window-bg px-4 py-3 sm:px-5 sm:py-3.5">
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-[#FF5F56] border border-black/10 dark:border-white/10 shadow-sm"></div>
            <div class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-black/10 dark:border-white/10 shadow-sm"></div>
            <div class="w-3 h-3 rounded-full bg-[#27C93F] border border-black/10 dark:border-white/10 shadow-sm"></div>
          </div>
          <div class="hidden items-center gap-2 rounded-md border border-terminal-border/30 bg-surface-active/50 px-3 py-1 font-mono text-[12px] font-medium text-terminal-muted sm:flex">
            <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            ~/projects/nikcli
          </div>
          <div class="w-12"></div> <!-- Spacer for centering -->
        </div>

        <!-- Terminal Body -->
        <div class="relative min-h-[128px] overflow-x-auto bg-terminal-window-code p-5 font-mono text-[13px] leading-relaxed sm:min-h-[140px] sm:p-6 md:p-8 md:text-[15px]">
          <!-- Inner Shadow -->
          <div class="absolute inset-0 shadow-[inset_0_4px_15px_rgba(0,0,0,0.02)] pointer-events-none"></div>
          
          <div class="flex items-start gap-3 relative z-10">
            <span class="text-terminal-accent shrink-0 select-none font-bold mt-0.5">❯</span>
            <div class="flex-1 whitespace-pre-wrap break-all sm:whitespace-nowrap sm:break-normal">
              <span id="typewriter-cmd" class="text-terminal-window-text font-bold"></span>
              <span id="typewriter-flags" class="text-terminal-muted"></span>
              <span class="animate-cursor inline-block w-2.5 h-5 bg-terminal-text align-middle ml-1 -mt-0.5 shadow-[0_0_8px_rgba(var(--terminal-text)/0.5)] rounded-sm"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex w-full flex-col items-center justify-center gap-4 sm:flex-row sm:gap-5">
        <a href="/docs#installation" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-[15px] font-bold rounded-xl bg-terminal-text text-terminal-bg hover:bg-terminal-text/90 hover:-translate-y-0.5 transition-all shadow-[0_4px_14px_0_rgb(var(--terminal-shadow)/0.2)] hover:shadow-[0_6px_20px_rgba(var(--terminal-shadow)/0.3)] active:translate-y-0 active:scale-95 group relative overflow-hidden">
          <span class="absolute inset-0 bg-white/20 dark:bg-black/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></span>
          <span class="relative">Start Building</span>
        </a>
        <a href="/docs" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-[15px] font-bold rounded-xl bg-surface-hover text-terminal-text hover:bg-terminal-panel border border-terminal-border/80 hover:border-terminal-accent/50 transition-all shadow-sm hover:shadow-soft hover:-translate-y-0.5 active:translate-y-0 active:scale-95">
          Read Documentation
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  const cmdText = "nikcli ";
  const flagsText = "--agent=build --model=claude-sonnet-4";
  
  const cmdEl = document.getElementById("typewriter-cmd");
  const flagsEl = document.getElementById("typewriter-flags");
  
  let i = 0;
  let j = 0;
  const prefersReduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function typeWriter() {
    if (i < cmdText.length && cmdEl) {
      cmdEl.textContent += cmdText.charAt(i);
      i++;
      setTimeout(typeWriter, 40);
    } else if (j < flagsText.length && flagsEl) {
      flagsEl.textContent += flagsText.charAt(j);
      j++;
      setTimeout(typeWriter, 30);
    }
  }

  // Clear initially so it doesn't blink pre-rendered text before animation
  if(cmdEl) cmdEl.textContent = '';
  if(flagsEl) flagsEl.textContent = '';

  if (cmdEl && flagsEl) {
    if (prefersReduced) {
      cmdEl.textContent = cmdText;
      flagsEl.textContent = flagsText;
    } else {
      setTimeout(typeWriter, 800);
    }
  }
</script>
