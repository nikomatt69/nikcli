---
const navItems = [
  { href: "/docs", label: "Docs" },
  { href: "https://github.com/nikomatt69/nikcli", label: "GitHub", external: true },
];
const pathname = Astro.url.pathname;
---

<nav class="sticky top-0 z-50 w-full border-b border-terminal-border/60 dark:border-white/5 bg-terminal-bg/70 dark:bg-terminal-bg/80 backdrop-blur-xl transition-all duration-300 shadow-sm" aria-label="Primary">
  <div class="container mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 font-mono font-bold text-lg tracking-tight hover:text-terminal-accent transition-colors group">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-terminal-accent/20 to-terminal-accent/5 flex items-center justify-center border border-terminal-accent/30 group-hover:bg-terminal-accent/30 group-hover:shadow-[0_0_20px_-3px_rgb(var(--terminal-accent)/0.4)] group-active:scale-95 transition-all">
        <svg viewBox="0 0 24 24" class="w-4 h-4 text-terminal-accent" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 17l6-6-6-6M12 19h8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <span class="text-terminal-text">nikcli</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-6">
      <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface-hover/50 border border-terminal-border/30">
        {navItems.map((item) => {
          const isActive = !item.external && pathname.startsWith(item.href);
          return (
          <a
            href={item.href}
            class={`px-3.5 py-1.5 rounded-lg text-[13px] font-semibold transition-all duration-300 ${isActive ? "bg-terminal-panel text-terminal-text shadow-sm ring-1 ring-terminal-border/50" : "text-terminal-muted hover:text-terminal-text hover:bg-surface-active"}`}
            aria-current={isActive ? "page" : undefined}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
          >
            {item.label}
            {item.external && <span class="ml-1 inline-block text-[10px] opacity-40">↗</span>}
          </a>
        );
        })}
      </div>
      
      <div class="h-5 w-px bg-terminal-border/60 mx-1"></div>

      <div class="flex items-center gap-3">
        <button
          id="theme-toggle"
          class="w-9 h-9 rounded-full flex items-center justify-center text-terminal-muted hover:text-terminal-text hover:bg-surface-active border border-transparent hover:border-terminal-border/50 hover:shadow-soft active:scale-90 transition-all"
          type="button"
          aria-label="Toggle theme"
          aria-pressed="false"
        >
          <span class="theme-icon block dark:hidden" data-theme-icon="sun" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
              <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.2 2.2M16.9 16.9l2.2 2.2M19.1 4.9l-2.2 2.2M7.1 16.9l-2.2 2.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="theme-icon hidden dark:block" data-theme-icon="moon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M20 14.5A7.5 7.5 0 1 1 9.5 4a6.2 6.2 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
        <a href="/docs#installation" class="inline-flex items-center justify-center px-4 py-2 text-[13px] font-bold rounded-lg bg-terminal-text text-terminal-bg hover:-translate-y-0.5 active:translate-y-0 transition-all shadow-[0_4px_14px_0_rgb(var(--terminal-shadow)/0.15)] hover:shadow-[0_6px_20px_rgba(var(--terminal-shadow)/0.2)]">
          Install
        </a>
      </div>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden p-2 -mr-2 text-terminal-muted hover:text-terminal-text rounded-md hover:bg-surface-hover active:scale-95 transition-all" aria-label="Menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-terminal-bg/95 backdrop-blur-3xl border-b border-terminal-border shadow-2xl py-6 px-4 flex flex-col gap-5 origin-top transition-all z-50">
    <div class="flex flex-col gap-2">
      {navItems.map((item) => {
        const isActive = !item.external && pathname.startsWith(item.href);
        return (
        <a
          href={item.href}
          class={`px-4 py-3.5 rounded-xl text-base font-bold transition-colors flex items-center justify-between ${isActive ? "bg-surface-active text-terminal-text shadow-sm ring-1 ring-terminal-border/50" : "text-terminal-muted hover:text-terminal-text hover:bg-surface-hover"}`}
        >
          {item.label}
          {item.external && <svg class="w-4 h-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>}
        </a>
      );
      })}
    </div>
    <div class="pt-5 border-t border-terminal-border/60 flex items-center justify-between px-2">
      <span class="text-sm font-semibold text-terminal-muted">Toggle Theme</span>
      <button id="theme-toggle-mobile" class="p-2.5 rounded-full bg-surface-active text-terminal-text shadow-sm ring-1 ring-terminal-border/50 active:scale-90 transition-transform">
        <span class="theme-icon block dark:hidden" data-theme-icon="sun"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.2 2.2M16.9 16.9l2.2 2.2M19.1 4.9l-2.2 2.2M7.1 16.9l-2.2 2.2"/></svg></span>
        <span class="theme-icon hidden dark:block" data-theme-icon="moon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 14.5A7.5 7.5 0 1 1 9.5 4a6.2 6.2 0 0 0 10.5 10.5Z"/></svg></span>
      </button>
    </div>
    <a href="/docs#installation" class="w-full text-center py-4 rounded-xl bg-terminal-text text-terminal-bg font-bold mt-2 shadow-strong active:scale-95 transition-transform">
      Install nikcli
    </a>
  </div>
</nav>

<script>
  // Theme Toggle Logic
  const setupThemeToggle = () => {
    const root = document.documentElement;
    const toggles = [document.getElementById("theme-toggle"), document.getElementById("theme-toggle-mobile")];
    const stored = localStorage.getItem("theme");
    const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
    const current = root.getAttribute("data-theme");
    const initial = current || stored || (prefersDark ? "dark" : "light");
    
    if (!current) root.setAttribute("data-theme", initial);
    
    toggles.forEach(toggle => {
      if(!toggle) return;
      toggle.setAttribute("aria-pressed", initial === "dark" ? "true" : "false");
      
      toggle.addEventListener("click", () => {
        const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
        
        toggles.forEach(t => {
          if(!t) return;
          t.setAttribute("aria-pressed", next === "dark" ? "true" : "false");
        });
      });
    });
  };

  // Mobile Menu Logic
  const setupMobileMenu = () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    let isOpen = false;

    const newBtn = btn?.cloneNode(true);
    if(btn && newBtn && btn.parentNode) {
      btn.parentNode.replaceChild(newBtn, btn);
    }

    newBtn?.addEventListener('click', () => {
      isOpen = !isOpen;
      if (isOpen) {
        menu?.classList.remove('hidden');
        newBtn.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
        document.body.style.overflow = 'hidden';
      } else {
        menu?.classList.add('hidden');
        newBtn.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>`;
        document.body.style.overflow = '';
      }
    });
  };

  setupThemeToggle();
  setupMobileMenu();
</script>
