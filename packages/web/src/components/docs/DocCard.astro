---
interface Props {
  title?: string;
  eyebrow?: string;
  href?: string;
}
const { title, eyebrow, href } = Astro.props;

const Element = href ? 'a' : 'div';
---

<Element 
  href={href} 
  class={`doc-card card-surface relative z-10 block overflow-hidden border border-terminal-border/80 bg-terminal-panel p-5 shadow-soft transition-all duration-500 group not-prose sm:p-6 lg:p-7 ${href ? 'cursor-pointer hover:-translate-y-1 hover:border-terminal-accent/50 hover:bg-surface-hover hover:shadow-strong' : ''}`}
>
  <!-- Background Glow on hover -->
  {href && <div class="absolute inset-0 bg-gradient-to-br from-terminal-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 -z-10 pointer-events-none"></div>}

  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      {eyebrow && <div class="mb-4 inline-flex items-center gap-2 rounded-md border border-terminal-accent/20 bg-terminal-accent/10 px-2.5 py-1 font-mono text-eyebrow uppercase text-terminal-accent">
        {eyebrow}
      </div>}

      {title && <h3 class="text-card-title text-terminal-text transition-colors duration-300 group-hover:text-terminal-accent">{title}</h3>}
    </div>

    {href && <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-terminal-border/70 bg-terminal-code text-terminal-muted transition-all duration-300 group-hover:border-terminal-accent/30 group-hover:bg-terminal-accent/10 group-hover:text-terminal-accent">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
    </span>}
  </div>
  
  <div class="mt-4 text-body-sm text-terminal-muted [&_code]:whitespace-normal [&_code]:break-words [&_code]:rounded-md [&_code]:border [&_code]:border-terminal-border/70 [&_code]:bg-terminal-code [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[0.92em] [&_code]:font-medium [&_code]:text-terminal-text [&_p]:m-0 [&_p+*]:mt-3">
    <slot />
  </div>

  {href && <div class="mt-5 flex items-center justify-between border-t border-terminal-border/70 pt-4 text-sm font-semibold text-terminal-text">
    <span>Open reference</span>
    <span class="text-terminal-accent transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
  </div>}
</Element>
