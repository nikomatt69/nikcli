---
interface Props {
  title?: string;
  eyebrow?: string;
  href?: string;
}
const { title, eyebrow, href } = Astro.props;

const Element = href ? 'a' : 'div';
---

<Element
  href={href}
  class={[
    "doc-card card-surface group relative block overflow-hidden border border-terminal-border/60 bg-terminal-panel not-prose",
    "transition-[transform,border-color,box-shadow,background-color] duration-200 ease-out focus:outline-none focus-visible:ring-2 focus-visible:ring-terminal-accent/40",
    href
      ? "cursor-pointer hover:-translate-y-[2px] hover:border-terminal-accent/40 hover:shadow-strong active:scale-[0.985]"
      : "",
    "p-5 sm:p-6",
  ].join(" ")}
>
  <!-- Amber clip-path reveal bar -->
  {href && (
    <div class="doc-card-bar absolute left-0 top-4 bottom-4 w-[3px] rounded-full overflow-hidden" aria-hidden="true">
      <div class="h-full w-full bg-terminal-accent doc-card-bar-inner" />
    </div>
  )}

  <!-- Hover tint -->
  {href && (
    <div class="absolute inset-0 bg-gradient-to-br from-terminal-accent/4 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none -z-0" aria-hidden="true" />
  )}

  <div class="relative z-10">
    <!-- Eyebrow -->
    {eyebrow && (
      <div class="mb-3.5 inline-flex items-center gap-1.5 rounded-md border border-terminal-accent/20 bg-terminal-accent/8 px-2 py-0.5 font-mono text-[10.5px] font-bold uppercase tracking-[0.18em] text-terminal-accent">
        {eyebrow}
      </div>
    )}

    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0 flex-1">
        {title && (
          <h3 class="font-display text-card-title font-bold tracking-tight text-terminal-text transition-colors duration-150 group-hover:text-terminal-text mb-0">
            {title}
          </h3>
        )}
      </div>

      {href && (
        <span class="shrink-0 flex h-8 w-8 items-center justify-center rounded-lg border border-terminal-border/60 bg-surface-active text-terminal-muted transition-[transform,border-color,background-color,color] duration-150 ease-out group-hover:border-terminal-accent/40 group-hover:bg-terminal-accent/10 group-hover:text-terminal-accent" aria-hidden="true">
          <svg class="h-3.5 w-3.5 transition-transform duration-150 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </span>
      )}
    </div>

    <!-- Body content -->
    <div class="mt-3 text-[14px] font-normal leading-[1.7] text-terminal-muted [&_code]:whitespace-normal [&_code]:break-words [&_code]:rounded [&_code]:border [&_code]:border-terminal-border/60 [&_code]:bg-terminal-code [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[0.875em] [&_code]:font-medium [&_code]:text-terminal-text [&_p]:m-0 [&_p+*]:mt-2.5">
      <slot />
    </div>

    {href && (
      <div class="mt-4 flex items-center justify-between border-t border-terminal-border/50 pt-3.5">
        <span class="text-[12.5px] font-semibold text-terminal-muted group-hover:text-terminal-text transition-colors duration-100">Open reference</span>
        <span class="text-[12.5px] font-bold text-terminal-accent transition-transform duration-150 group-hover:translate-x-0.5 inline-block">&rarr;</span>
      </div>
    )}
  </div>
</Element>

<style>
  .doc-card-bar-inner {
    clip-path: inset(100% 0 0 0);
    transition: clip-path 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .doc-card:hover .doc-card-bar-inner {
    clip-path: inset(0 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .doc-card-bar-inner {
      transition: none;
    }
  }
</style>
