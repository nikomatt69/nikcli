---
type CalloutType = "info" | "warn" | "success" | "note" | "error";

interface Props {
  type?: CalloutType;
  title?: string;
}

const { type = "info", title } = Astro.props;

const styles = {
  info: "bg-blue-500/10 border-blue-500/20 text-blue-800 dark:text-blue-300 [&_strong]:text-blue-900 dark:[&_strong]:text-blue-200",
  note: "bg-surface-active border-terminal-border/60 text-terminal-text [&_strong]:text-terminal-text shadow-sm",
  warn: "bg-amber-500/10 border-amber-500/20 text-amber-800 dark:text-amber-300 [&_strong]:text-amber-900 dark:[&_strong]:text-amber-200",
  error: "bg-red-500/10 border-red-500/20 text-red-800 dark:text-red-300 [&_strong]:text-red-900 dark:[&_strong]:text-red-200",
  success: "bg-emerald-500/10 border-emerald-500/20 text-emerald-800 dark:text-emerald-300 [&_strong]:text-emerald-900 dark:[&_strong]:text-emerald-200"
};

const iconColors = {
  info: "text-blue-600 dark:text-blue-400",
  note: "text-terminal-muted",
  warn: "text-amber-600 dark:text-amber-400",
  error: "text-red-600 dark:text-red-400",
  success: "text-emerald-600 dark:text-emerald-400"
}

const icons = {
  info: `<svg class="w-5 h-5 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  note: `<svg class="w-5 h-5 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`,
  warn: `<svg class="w-5 h-5 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`,
  error: `<svg class="w-5 h-5 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  success: `<svg class="w-5 h-5 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
};
---

<div class={`flex gap-3 my-8 p-5 rounded-2xl border ${styles[type]} text-[15px] leading-relaxed not-prose shadow-sm transition-colors duration-300`}>
  <div class={`shrink-0 ${iconColors[type]}`} set:html={icons[type]}></div>
  <div class="flex-1">
    {title && <strong class="block font-semibold mb-1 text-inherit">{title}</strong>}
    <div class="text-inherit opacity-90 prose-p:mt-0 prose-p:mb-2 last:prose-p:mb-0 prose-a:underline prose-a:underline-offset-2 hover:prose-a:opacity-80 transition-opacity">
      <slot />
    </div>
  </div>
</div>
