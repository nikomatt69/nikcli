---
interface Props {
  language?: string;
  title?: string;
}
const { language, title } = Astro.props;
---

<div class="relative group my-8 not-prose rounded-xl overflow-hidden border border-terminal-window-border bg-[#FAFAFA] dark:bg-[#0E0E10] shadow-md transition-colors duration-300">
  <div class="flex items-center justify-between px-4 py-3 bg-[#F1F3F5] dark:bg-[#18181B] border-b border-terminal-window-border transition-colors duration-300">
    <div class="flex items-center gap-3">
      <div class="flex gap-1.5 opacity-90 group-hover:opacity-100 transition-opacity">
        <div class="w-3 h-3 rounded-full bg-[#FF5F56] border border-black/10 dark:border-white/10 shadow-sm"></div>
        <div class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-black/10 dark:border-white/10 shadow-sm"></div>
        <div class="w-3 h-3 rounded-full bg-[#27C93F] border border-black/10 dark:border-white/10 shadow-sm"></div>
      </div>
      {title && <span class="text-[13px] font-medium text-terminal-muted flex items-center gap-2">
        <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
        {title}
      </span>}
    </div>
    {language && (
      <span class="text-[10px] font-mono font-bold text-terminal-muted/80 dark:text-terminal-muted uppercase tracking-[0.2em] bg-surface-active px-2.5 py-1 rounded border border-terminal-border/50 transition-colors">
        {language}
      </span>
    )}
  </div>
  <div class="p-5 overflow-x-auto text-[13px] md:text-sm font-mono text-terminal-text leading-[1.7] transition-colors duration-300">
    <slot />
  </div>
</div>
