---
interface Props {
  language?: string;
  title?: string;
}
const { language, title } = Astro.props;

function normalizeCodeBlock(value: string) {
  const trimmed = value.replace(/^\s*\n/, "").replace(/\n\s*$/, "")
  if (!trimmed) return ""

  const lines = trimmed.split("\n")
  const indentation = lines
    .filter((line) => line.trim().length > 0)
    .reduce((smallest, line) => {
      const leading = line.match(/^\s*/)?.[0].length ?? 0
      return Math.min(smallest, leading)
    }, Number.POSITIVE_INFINITY)

  if (!Number.isFinite(indentation)) return trimmed

  return lines.map((line) => line.slice(indentation)).join("\n")
}

const rawCode = Astro.slots.has("default") ? await Astro.slots.render("default") : ""
const code = normalizeCodeBlock(rawCode)
---

<div class="group relative my-8 overflow-hidden rounded-[var(--radius-card)] border border-terminal-window-border/80 bg-terminal-window-bg shadow-soft transition-colors duration-300 not-prose">
  <div class="flex items-center justify-between gap-3 border-b border-terminal-window-border/80 bg-gradient-to-b from-surface-hover to-terminal-window-bg px-4 py-3 sm:px-5">
    <div class="flex items-center gap-3">
      <div class="flex gap-1.5 opacity-90 group-hover:opacity-100 transition-opacity">
        <div class="h-3 w-3 rounded-full border border-black/10 bg-[#FF5F56] shadow-sm dark:border-white/10"></div>
        <div class="h-3 w-3 rounded-full border border-black/10 bg-[#FFBD2E] shadow-sm dark:border-white/10"></div>
        <div class="h-3 w-3 rounded-full border border-black/10 bg-[#27C93F] shadow-sm dark:border-white/10"></div>
      </div>
      {title && <span class="flex items-center gap-2 text-[13px] font-medium text-terminal-window-muted">
        {title}
      </span>}
    </div>
    {language && (
      <span class="rounded-lg border border-terminal-window-border/80 bg-surface-active px-2.5 py-1 text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-terminal-window-muted transition-colors">
        {language}
      </span>
    )}
  </div>
  <pre class="overflow-x-auto bg-terminal-window-code/80 p-5 text-[13px] leading-[1.7] text-terminal-window-text md:text-sm"><code class="block min-w-fit whitespace-pre font-mono">{code}</code></pre>
</div>
