---
const features = [
  {
    title: 'Open Source Freedom',
    description: '100% open source under MIT license. Build, modify, and deploy without lock-in or hidden subscription costs.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>'
  },
  {
    title: 'Provider Agnostic AI',
    description: 'Bring your own keys. Seamlessly switch between Claude, OpenAI, Gemini, or self-hosted local models on the fly.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>'
  },
  {
    title: 'Native LSP Intelligence',
    description: 'Deep code understanding via built-in Language Server Protocol. Nikcli reads your types, not just your text.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>'
  },
  {
    title: 'Built for the Terminal',
    description: 'Designed by and for keyboard warriors. Zero GUI overhead, pure speed, and total integration with your dotfiles.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>'
  },
  {
    title: 'Remote Execution',
    description: 'Run the heavy lifting on a server, control it locally. Client-server architecture built for modern dev workflows.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>'
  },
  {
    title: 'MCP Native Integration',
    description: 'First-class support for Model Context Protocol. Extend Nikclis capabilities with standard community tools.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>'
  },
];
---

<section class="py-32 bg-surface-hover/30 border-y border-terminal-border/60">
  <div class="container mx-auto px-4">
    
    <div class="max-w-3xl mb-20 text-center mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-terminal-accent/10 text-[11px] font-mono font-bold text-terminal-accent mb-6 uppercase tracking-widest border border-terminal-accent/20">
        Engineered for speed
      </div>
      <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6 text-terminal-text leading-[1.1]">Powerful primitives</h2>
      <p class="text-lg md:text-xl text-terminal-muted leading-relaxed font-medium">
        Everything you need to automate your development workflow, packed into a single blazing-fast binary.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 max-w-7xl mx-auto">
      {features.map((feature, index) => (
        <div class="feature-card group relative p-8 md:p-10 rounded-3xl bg-terminal-panel border border-terminal-border/80 dark:border-white/5 hover:border-terminal-accent/50 dark:hover:border-terminal-accent/40 transition-all duration-500 shadow-soft hover:shadow-strong overflow-hidden z-10 hover:-translate-y-1">
          
          <!-- Hover Gradient Background -->
          <div class="absolute inset-0 bg-gradient-to-br from-terminal-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 -z-10 pointer-events-none"></div>
          
          <!-- Icon Container -->
          <div class="w-14 h-14 rounded-2xl bg-surface-active border border-terminal-border/60 dark:border-white/5 shadow-inner flex items-center justify-center mb-8 text-terminal-text group-hover:text-terminal-accent group-hover:scale-110 transition-all duration-500 ease-out">
             <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={feature.icon}></svg>
          </div>
          
          <h3 class="text-2xl font-bold tracking-tight mb-4 text-terminal-text group-hover:text-terminal-accent transition-colors duration-300">
            {feature.title}
          </h3>
          
          <p class="text-terminal-muted text-[17px] leading-[1.7] font-medium">
            {feature.description}
          </p>

        </div>
      ))}
    </div>

  </div>
</section>
