---
---
<section class="page-section relative" id="installation">
  <!-- Subtle decorative background line -->
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-terminal-border to-transparent opacity-50"></div>
  
  <div class="page-shell flex flex-col items-center">
    
    <div class="mb-10 w-full max-w-2xl text-center sm:mb-12">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-terminal-text md:text-4xl">Get Nikcli today</h2>
      <p class="text-base text-terminal-muted sm:text-lg">
        Install the CLI in seconds. No complex setup required.
      </p>
    </div>

    <!-- Installation Terminal Snippet -->
    <div class="group card-surface relative flex w-full max-w-2xl flex-col items-start justify-between gap-4 overflow-hidden border border-terminal-border/80 bg-terminal-panel p-3 shadow-strong transition-all duration-300 hover:border-terminal-accent/30 hover:shadow-glow dark:border-white/10 sm:flex-row sm:items-center sm:pl-6">
      
      <!-- Subtle inset shadow/glow on hover -->
      <div class="absolute inset-0 bg-gradient-to-r from-terminal-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

      <code class="relative z-10 overflow-x-auto whitespace-pre-wrap break-all bg-transparent p-0 py-2 font-mono text-[14px] text-terminal-text sm:whitespace-nowrap sm:break-normal sm:py-0 sm:text-[15px]">
        <span class="text-terminal-accent mr-3 select-none">❯</span>curl -fsSL https://nikcli.store/install | bash
      </code>
      
      <button
        id="copy-install"
        class="shrink-0 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-surface-active hover:bg-terminal-text text-terminal-text hover:text-terminal-bg font-semibold text-sm transition-all duration-300 border border-terminal-border hover:border-transparent active:scale-95 shadow-sm relative z-10 w-full sm:w-auto"
        type="button"
        aria-live="polite"
      >
        <svg id="copy-icon-idle" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
        <svg id="copy-icon-success" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
        <span id="copy-text">Copy</span>
      </button>
    </div>
    
    <p class="mt-6 text-center text-sm text-terminal-muted transition-colors sm:mt-8">
      Requires Node.js 18+. See <a href="/docs#installation" class="text-terminal-text underline underline-offset-4 decoration-terminal-border hover:decoration-terminal-accent transition-colors font-medium">documentation</a> for Windows and manual methods.
    </p>

  </div>
</section>

<script>
  const copyButton = document.getElementById('copy-install');
  const iconIdle = document.getElementById('copy-icon-idle');
  const iconSuccess = document.getElementById('copy-icon-success');
  const btnText = document.getElementById('copy-text');
  const commandText = 'curl -fsSL https://nikcli.store/install | bash';

  async function copyCommand() {
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(commandText);
        return true;
      }
      return false;
    } catch {
      return false;
    }
  }

  copyButton?.addEventListener('click', async () => {
    const ok = await copyCommand();
    if(ok && iconIdle && iconSuccess && btnText && copyButton) {
      iconIdle.classList.add('hidden');
      iconSuccess.classList.remove('hidden');
      btnText.textContent = 'Copied!';
      copyButton.classList.add('!bg-green-500', '!text-white', '!border-green-500');
      
      setTimeout(() => {
        iconIdle.classList.remove('hidden');
        iconSuccess.classList.add('hidden');
        btnText.textContent = 'Copy';
        copyButton.classList.remove('!bg-green-500', '!text-white', '!border-green-500');
      }, 2000);
    }
  });
</script>
