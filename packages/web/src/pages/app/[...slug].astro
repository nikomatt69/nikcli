---
import Layout from '@/layouts/Layout.astro'
import AppShell from '@/app/AppShell'
import Navbar from '@/components/Navbar.astro'

const initialPath = Astro.url.pathname
---

<Layout title="Nikcli Web App" description="Use Nikcli from the browser through the same headless mobile routes and Railway-hosted server.">
  <Navbar />
  <AppShell client:load initialPath={initialPath} />
</Layout>

{/* Webapp shell: keep page scroll functional but hide the visible scrollbar (scoped to /app routes) */}
<style is:global>
  html,
  body {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* legacy Edge/IE */
  }
  html::-webkit-scrollbar,
  body::-webkit-scrollbar {
    width: 0;
    height: 0;
    display: none; /* WebKit/Blink */
  }
</style>
