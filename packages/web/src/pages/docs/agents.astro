---
import DocsLayout from "../../layouts/DocsLayout.astro";
import DocCallout from "../../components/docs/DocCallout.astro";
import DocCard from "../../components/docs/DocCard.astro";

const toc = [
  { title: "Primary Agents", href: "#primary-agents", depth: 2 },
  { title: "Delegated Agents", href: "#delegated-agents", depth: 2 },
  { title: "Modes & Permissions", href: "#modes-permissions", depth: 2 },
  { title: "Customization", href: "#customization", depth: 2 },
];
---

<DocsLayout
  title="Agents"
  subtitle="Agents are defined in packages/nikcli/src/agent/agent.ts and configured through nikcli config overlays."
  description="Reference for Nikcli agents, subagent profiles, permissions, and config overlays."
  toc={toc}
>
  <section id="primary-agents" class="mb-16 scroll-mt-24">
    <h2>Primary Agents</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
      <DocCard title="ralph" eyebrow="Primary">
        <p>Conversational primary agent intended for lighter interactive work.</p>
      </DocCard>
      <DocCard title="build" eyebrow="Primary">
        <p>Default coding agent with the broadest tool access and edit-oriented workflows.</p>
      </DocCard>
      <DocCard title="plan" eyebrow="Primary">
        <p>Structured planning agent for outlining work before execution.</p>
      </DocCard>
    </div>
  </section>

  <section id="delegated-agents" class="mb-16 scroll-mt-24">
    <h2>Delegated Agents</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
      <DocCard title="general"><p>General-purpose agent for researching complex questions and executing multiple units of work in parallel.</p></DocCard>
      <DocCard title="explore"><p>Exploration agent optimized for codebase discovery with read, grep, glob, bash, webfetch, and search access.</p></DocCard>
      <DocCard title="fast-explore"><p>Faster read-only exploration profile limited to read, grep, glob, list, and tree.</p></DocCard>
      <DocCard title="planner"><p>Planning-oriented agent for multi-step implementation strategies; produces step-by-step plans without modifying files.</p></DocCard>
      <DocCard title="scout"><p>Read-only research agent for external libraries, dependency source, documentation, and public repositories. Can clone remote repos via <code>repo_clone</code>. Requires the <code>NIKCLI_EXPERIMENTAL_SCOUT</code> flag.</p></DocCard>
      <DocCard title="researcher"><p>Read-only background research agent that collects evidence and returns source-backed findings; can delegate subtasks to <code>fast-explore</code> or <code>planner</code>.</p></DocCard>
      <DocCard title="code-reviewer"><p>Reviews code for quality and safety using read, grep, glob, list, and bash.</p></DocCard>
      <DocCard title="ultrareview-reviewer"><p>Specialized reviewer for a single domain within a parallel ultrareview fleet; hidden from the primary agent picker.</p></DocCard>
      <DocCard title="debugger"><p>Debugging-oriented agent with read, search, shell, and edit access; identifies root cause and applies minimal fixes.</p></DocCard>
      <DocCard title="test-runner"><p>Runs tests, analyzes failures, and proposes fixes using read, grep, list, bash, and edit.</p></DocCard>
      <DocCard title="refactor"><p>Applies safe cleanups without intended behavior changes using read, grep, glob, bash, edit, and write.</p></DocCard>
      <DocCard title="delegator"><p>Coordination agent that synthesizes results from background subagent runs; operates as an internal helper and is hidden from the primary agent picker.</p></DocCard>
    </div>
  </section>

  <section id="modes-permissions" class="mb-16 scroll-mt-24">
    <h2>Modes & Permissions</h2>
    <table class="doc-table">
      <thead>
        <tr>
          <th>Mode</th>
          <th>Meaning</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><code>primary</code></td><td>Available as a top-level agent for normal sessions.</td></tr>
        <tr><td><code>subagent</code></td><td>Available only for delegated work.</td></tr>
        <tr><td><code>all</code></td><td>Can be used as both a primary and delegated agent.</td></tr>
        <tr><td><code>hidden</code></td><td>Internal helpers such as <code>compaction</code>, <code>title</code>, and <code>summary</code>.</td></tr>
      </tbody>
    </table>

    <DocCallout type="info" title="Permission merging">
      <p>
        Each agent starts from default permissions, applies its built-in overrides, and then merges
        any user config overrides on top.
      </p>
    </DocCallout>
  </section>

  <section id="customization" class="mb-16 scroll-mt-24">
    <h2>Customization</h2>
    <p>
      Agents can be added, disabled, or overridden in <code>config.agent</code>. Common fields
      include <code>model</code>, <code>prompt</code>, <code>description</code>,
      <code>temperature</code>, <code>top_p</code>, <code>mode</code>, <code>steps</code>,
      <code>hidden</code>, and <code>permission</code>.
    </p>
  </section>
</DocsLayout>
