import DocCard from "../../components/docs/DocCard.astro";

const toc = [
  { title: "Overview", href: "#overview", depth: 2 },
  { title: "Install a plugin", href: "#install", depth: 2 },
  { title: "Config patching", href: "#patching", depth: 2 },
  { title: "Server runtime", href: "#server-runtime", depth: 2 },
  { title: "TUI runtime", href: "#tui-runtime", depth: 2 },
  { title: "Built-in plugins", href: "#built-ins", depth: 2 },
  { title: "Plugin manifest", href: "#manifest", depth: 2 },
  { title: "Skills", href: "#skills", depth: 2 },
