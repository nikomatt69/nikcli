const toc = [
  { title: "What Are Routines", href: "#what-are-routines", depth: 2 },
  { title: "Triggers", href: "#triggers", depth: 2 },
  { title: "Subcommands", href: "#subcommands", depth: 2 },
  { title: "Creating a Routine", href: "#creating-a-routine", depth: 2 },
