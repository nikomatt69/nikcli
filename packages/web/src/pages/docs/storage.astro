---
export const prerender = true

import DocsLayout from "../../layouts/DocsLayout.astro";
import DocCallout from "../../components/docs/DocCallout.astro";
import DocCode from "../../components/docs/DocCode.astro";
import DocCard from "../../components/docs/DocCard.astro";

const toc = [
  { title: "Overview", href: "#overview", depth: 2 },
  { title: "Path roots", href: "#path-roots", depth: 2 },
  { title: "The database", href: "#database", depth: 2 },
  { title: "Tables and owners", href: "#tables", depth: 2 },
  { title: "Repository pattern", href: "#repositories", depth: 2 },
  { title: "Transactions", href: "#transactions", depth: 2 },
  { title: "Migrations", href: "#migrations", depth: 2 },
  { title: "Files outside the database", href: "#files", depth: 2 },
  { title: "Operational checks", href: "#operational-checks", depth: 2 },
  { title: "Failure modes", href: "#failure-modes", depth: 2 },
  { title: "Source anchors", href: "#source-anchors", depth: 2 },
];

const tables = [
  { table: "project", owner: "src/project/project.sql.ts", purpose: "Known projects, git roots, and per-project metadata." },
  { table: "session_info", owner: "src/session/session.sql.ts", purpose: "Session records; indexed columns plus a JSON `data` blob for the rest." },
  { table: "message_info, message_part", owner: "src/session/message.sql.ts", purpose: "Messages and their parts — text, reasoning, tool calls, files." },
  { table: "session_entry", owner: "src/session/v2/entry.sql.ts", purpose: "The flat v2 event-sourced session log and its persisted projection." },
  { table: "session_goal", owner: "src/session/goal.sql.ts", purpose: "Per-session goal state driven by the goal tools." },
  { table: "session_diff", owner: "src/session/diff.sql.ts", purpose: "File diffs backing summaries, the changes view, and revert." },
  { table: "session_pending", owner: "src/session/pending.sql.ts", purpose: "Queued prompts and steering messages for a busy session." },
  { table: "todo_info", owner: "src/session/todo.sql.ts", purpose: "Todo list state written by the todo tools." },
  { table: "instruction_blob, instruction_state", owner: "src/session/instruction.sql.ts", purpose: "Instruction files and their per-session enable/disable state." },
  { table: "permission_ruleset", owner: "src/permission/permission.sql.ts", purpose: "Persisted always-approvals and per-agent permission rulesets." },
  { table: "loop, loop_run", owner: "src/loop/loop.sql.ts", purpose: "Loop definitions and run history. See Loops." },
  { table: "mission, mission_exec", owner: "src/mission/mission.sql.ts", purpose: "Mission definitions and executions. See Missions." },
  { table: "routine", owner: "src/mobile/routine.sql.ts", purpose: "Scheduled and API-triggered routines." },
  { table: "background_run", owner: "src/background/run.sql.ts", purpose: "Background delegation runs and their status." },
  { table: "monitor", owner: "src/monitor/monitor.sql.ts", purpose: "Long-lived process monitors and their logs." },
  { table: "artifact", owner: "src/artifact/artifact.sql.ts", purpose: "Session artifacts surfaced in the TUI and mobile viewers." },
  { table: "session_share, local_share", owner: "src/share/share.sql.ts", purpose: "Share records for public session links." },
  { table: "sync_event, sync_sequence, sync_snapshot, sync_outbox", owner: "src/sync/sync.sql.ts", purpose: "The sync event journal, sequences, snapshots, and idempotent outbox." },
  { table: "workspace", owner: "src/workspace/workspace.sql.ts", purpose: "Workspace records, target config, and status." },
  { table: "users, user_sessions, chat_contacts, chat_messages", owner: "src/user/users.sql.ts", purpose: "Local server accounts and the chat surface." },
  { table: "account, config", owner: "src/account/account.sql.ts", purpose: "nikcli account records, tokens, and the active account." },
  { table: "mobile_tokens", owner: "src/mobile/auth.sql.ts", purpose: "Hashed mobile bearer tokens with creation, last-used, and expiry." },
];
---

<DocsLayout
  title="Storage"
  subtitle="Where nikcli keeps persistent data: one SQLite database, the repository layer above it, migrations, and the files that stay on disk."
  description="Reference for nikcli persistent storage — the nikcli.db SQLite database, Drizzle schema, repositories, migrations, and data roots."
  toc={toc}
>
  <section id="overview" class="doc-section">
    <h2>Overview</h2>
    <p>
      All durable runtime state lives in a single SQLite database —
      <code>nikcli.db</code> under <code>Global.Path.data</code> — accessed through Drizzle.
      Projects, sessions, messages, parts, diffs, todos, goals, permissions, loops, missions,
      routines, workspaces, accounts, mobile tokens, and the sync journal are all tables in that one
      file.
    </p>
    <DocCallout type="info" title="The JSON object store and the per-domain databases are gone">
      <p>
        Earlier releases wrote JSON files under <code>Global.Path.data/storage</code> and kept
        separate <code>users.db</code>, <code>accounts.db</code>, <code>mobile_auth.db</code>, and
        <code>workspaces.db</code> files. Both models were consolidated into <code>nikcli.db</code>;
        the <code>20260611020000_import_legacy_databases</code> and
        <code>20260611030000_import_json_storage</code> migrations import the old data on first run.
        There is no <code>Storage.Service</code> and no <code>src/storage/</code> directory any more.
      </p>
    </DocCallout>
    <div class="doc-grid not-prose">
      <DocCard title="Data root" eyebrow="Global.Path.data">
        <p>
          Holds <code>nikcli.db</code>, <code>log/</code>, <code>bin/</code>, <code>repos/</code>,
          and snapshots. Override with <code>NIKCLI_DATA_DIR</code>, or isolate in tests with
          <code>NIKCLI_TEST_HOME</code>.
        </p>
      </DocCard>
      <DocCard title="One database" eyebrow="src/database/database.ts">
        <p>
          <code>bun:sqlite</code> in WAL mode behind a Drizzle client, opened once per filename and
          shared by every domain module. <code>NIKCLI_DB</code> overrides the filename.
        </p>
      </DocCard>
      <DocCard title="Repositories" eyebrow="*.sql.ts + *-repo.ts">
        <p>
          Each domain declares its tables in a <code>.sql.ts</code> file and its queries in a
          repository namespace. Domain services never touch Drizzle directly.
        </p>
      </DocCard>
      <DocCard title="Migrations" eyebrow="src/database/migration/">
        <p>
          Timestamp-named TypeScript migrations run inside a transaction and are recorded in a
          <code>migration</code> table, so each runs exactly once.
        </p>
      </DocCard>
    </div>
  </section>

  <section id="path-roots" class="doc-section">
    <h2>Path roots</h2>
    <p>
      <code>@nikcli-ai/util/global</code> owns the global directory model. On startup,
      <code>initialize()</code> creates the data, cache, config, state, log, bin, and repos
      directories. macOS and Linux follow XDG roots; Windows uses the native AppData layout instead
      of POSIX dotfiles.
    </p>
    <table class="doc-table">
      <thead><tr><th>Path</th><th>Default role</th><th>Contents</th></tr></thead>
      <tbody>
        <tr><td><code>Global.Path.data</code></td><td>Long-lived user data</td><td><code>nikcli.db</code> (plus its <code>-wal</code>/<code>-shm</code> siblings), <code>auth.json</code>, <code>snapshot/</code>, <code>plans/</code>.</td></tr>
        <tr><td><code>Global.Path.log</code></td><td>Logs</td><td><code>data/log</code>. Where <code>--print-logs</code> output is also written.</td></tr>
        <tr><td><code>Global.Path.bin</code></td><td>nikcli-managed binaries</td><td><code>data/bin</code>: LSP downloads, language servers, support binaries.</td></tr>
        <tr><td><code>Global.Path.repos</code></td><td>Hosted repositories</td><td><code>data/repos</code>: imported or managed repositories.</td></tr>
        <tr><td><code>Global.Path.cache</code></td><td>Disposable cache</td><td>Model lists, package cache, file search indexes. A cache-version bump clears the directory.</td></tr>
        <tr><td><code>Global.Path.config</code></td><td>User config</td><td><code>nikcli.json</code>, managed config, global themes, global skills.</td></tr>
        <tr><td><code>Global.Path.state</code></td><td>Ephemeral state</td><td>Locks, prompt stash, plugin metadata, brain lock files.</td></tr>
      </tbody>
    </table>
    <DocCode language="bash">
NIKCLI_DATA_DIR=/srv/nikcli-data nikcli serve --hostname 0.0.0.0 --port 4096
NIKCLI_DB=:memory: bun test test/path/file.test.ts
NIKCLI_TEST_HOME=/tmp/nikcli-test bun test test/path/file.test.ts
    </DocCode>
    <DocCallout type="warn" title="Path holders must re-resolve">
      <p>
        <code>Global.Path.*</code> are getters, and the test suite swaps
        <code>NIKCLI_TEST_HOME</code> per file. A singleton that captures a path at module load will
        keep writing to the previous home — resolve paths on access, not at import time.
      </p>
    </DocCallout>
  </section>

  <section id="database" class="doc-section">
    <h2>The database</h2>
    <p>
      <code>Database.path()</code> resolves the filename: <code>NIKCLI_DB</code> when set (absolute,
      relative to the data root, or the literal <code>:memory:</code>), otherwise
      <code>&lt;data&gt;/nikcli.db</code>. Opening applies a fixed set of PRAGMAs, runs pending
      migrations, and checkpoints the WAL.
    </p>
    <table class="doc-table">
      <thead><tr><th>PRAGMA</th><th>Value</th><th>Why</th></tr></thead>
      <tbody>
        <tr><td><code>journal_mode</code></td><td><code>WAL</code></td><td>Concurrent readers while a writer holds the file.</td></tr>
        <tr><td><code>synchronous</code></td><td><code>NORMAL</code></td><td>Durability that matches WAL without an fsync per commit.</td></tr>
        <tr><td><code>busy_timeout</code></td><td><code>5000</code></td><td>Wait rather than fail when the TUI, server, and CLI write at once.</td></tr>
        <tr><td><code>cache_size</code></td><td><code>-64000</code> (~64 MB)</td><td>Bounds the page cache explicitly.</td></tr>
        <tr><td><code>foreign_keys</code></td><td><code>ON</code></td><td>Cascades and referential integrity are enforced, not advisory.</td></tr>
        <tr><td><code>mmap_size</code></td><td><code>0</code></td><td>Keeps the process footprint from growing with the database file; the latency cost is dwarfed by model round-trips.</td></tr>
      </tbody>
    </table>
    <p>
      The client is a per-filename singleton, so every module in a process shares one connection.
      A background loop checkpoints the WAL periodically; <code>Database.close()</code> and
      <code>closeAll()</code> tear it down.
    </p>
    <table class="doc-table">
      <thead><tr><th>Entry point</th><th>Use</th></tr></thead>
      <tbody>
        <tr><td><code>Database.syncDb()</code></td><td>The shared Drizzle client. Safe from synchronous code — what repositories call.</td></tr>
        <tr><td><code>Database.syncNative()</code></td><td>The raw <code>bun:sqlite</code> handle for PRAGMAs and maintenance.</td></tr>
        <tr><td><code>Database.defaultLayer</code></td><td>The Effect layer for code that resolves the service through a layer instead.</td></tr>
        <tr><td><code>Database.layerFromPath(file)</code></td><td>Bind a specific database file — used by tests and tooling.</td></tr>
      </tbody>
    </table>
  </section>

  <section id="tables" class="doc-table-section doc-section">
    <h2>Tables and owners</h2>
    <p>
      <code>src/database/schema.ts</code> is the single re-export point: every table used by the
      Drizzle client is listed there, and each one is declared in its own domain module. That is the
      fastest way to see the current database surface.
    </p>
    <table class="doc-table">
      <thead><tr><th>Table(s)</th><th>Declared in</th><th>Purpose</th></tr></thead>
      <tbody>
        {tables.map((row) => (
          <tr>
            <td><code>{row.table}</code></td>
            <td><code>{row.owner}</code></td>
            <td>{row.purpose}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section id="repositories" class="doc-section">
    <h2>Repository pattern</h2>
    <p>
      Domain modules do not write SQL inline. Each domain pairs a schema file with a repository
      namespace — <code>SessionRepo</code>, <code>MessageRepo</code>, <code>LoopRepo</code>,
      <code>PermissionRepo</code>, and so on — that owns every query against its tables.
    </p>
    <ol>
      <li><strong>Schema</strong> (<code>*.sql.ts</code>) declares the Drizzle table, its columns, and its indexes.</li>
      <li><strong>Repository</strong> (<code>repo.ts</code> / <code>*-repo.ts</code>) exposes typed synchronous CRUD over <code>Database.syncDb()</code>.</li>
      <li><strong>Service</strong> (<code>index.ts</code>) adds business logic, publishes bus events, and is what routes and tools call.</li>
    </ol>
    <DocCallout type="info" title="Hot columns, cold JSON">
      <p>
        Records with a large or evolving shape — sessions are the clearest case — promote the fields
        that get filtered or sorted into real columns and keep the rest in a JSON <code>data</code>
        column. When a field is later promoted, the column becomes the source of truth and the JSON
        blob may be stale for older rows; <code>session_info.last_model</code> is the worked example
        in <code>src/session/repo.ts</code>.
      </p>
    </DocCallout>
  </section>

  <section id="transactions" class="doc-section">
    <h2>Transactions</h2>
    <p>
      <code>Database.transaction(fn)</code> runs a unit of work against a transaction handle. Nested
      calls join the outer transaction rather than starting a new one — SQLite has no real nesting —
      so a projector invoked inside a caller's transaction stays in that transaction.
    </p>
    <p>
      Repository writes accept an executor (<code>Database.TxOrDb</code>) precisely so a sync
      projector can append its event and update its projection atomically. Reads always use the
      shared client; they are never part of a projection.
    </p>
    <DocCallout type="note" title="Post-commit effects">
      <p>
        <code>Database.effect(fn)</code> queues work to run after the current transaction commits —
        never on rollback. Outside a transaction it runs immediately, because the caller's write has
        already landed. Publish bus events from there, not from inside the transaction body.
      </p>
    </DocCallout>
  </section>

  <section id="migrations" class="doc-section">
    <h2>Migrations</h2>
    <p>
      Migrations are TypeScript modules under <code>src/database/migration/</code>, named
      <code>&lt;timestamp&gt;_&lt;slug&gt;.ts</code>, each exporting an <code>id</code> and an
      <code>up(database)</code> function. <code>migration.gen.ts</code> imports them in order.
    </p>
    <p>
      <code>DatabaseMigration.apply()</code> creates a <code>migration</code> table, reads the
      applied ids, and runs each pending migration inside <code>BEGIN IMMEDIATE</code> — committing
      the migration and its bookkeeping row together, rolling both back on failure. Every open of the
      database runs this, so a fresh install and an upgrade converge on the same schema.
    </p>
    <table class="doc-table">
      <thead><tr><th>Migration</th><th>What it does</th></tr></thead>
      <tbody>
        <tr><td><code>20260610211500_initial</code></td><td>Creates the base schema.</td></tr>
        <tr><td><code>20260611020000_import_legacy_databases</code></td><td>Imports <code>users.db</code>, <code>accounts.db</code>, <code>mobile_auth.db</code>, and <code>workspaces.db</code> into <code>nikcli.db</code>.</td></tr>
        <tr><td><code>20260611030000_import_json_storage</code></td><td>Imports the old <code>data/storage</code> JSON object store — projects, sessions, messages, parts, diffs, todos.</td></tr>
        <tr><td><code>20260611040000_import_sync_json</code></td><td>Imports the pre-SQL sync journal.</td></tr>
        <tr><td><code>20260805000000_session_entry</code> …</td><td>Introduces the flat v2 session entry log and its id ordering; a later migration drops the interim <code>session_v2_event</code> table.</td></tr>
        <tr><td><code>202608140*_*_sql</code></td><td>The domain-by-domain move of loops, projects, goals, background runs, routines, diffs, workspaces, pending prompts, and instruction sync into SQL.</td></tr>
      </tbody>
    </table>
    <DocCallout type="warn" title="Adding a migration changes the journal list">
      <p>
        <code>test/database.test.ts</code> asserts the applied migration list. A new migration is
        expected to change it — update the test in the same commit, and back up the data root before
        replaying migration state by hand.
      </p>
    </DocCallout>
  </section>

  <section id="files" class="doc-section">
    <h2>Files outside the database</h2>
    <p>Some things are deliberately still files, because a file is the interface.</p>
    <table class="doc-table">
      <thead><tr><th>Data</th><th>Location</th><th>Why not SQL</th></tr></thead>
      <tbody>
        <tr><td>Config</td><td><code>nikcli.json</code> in the config dir and project roots</td><td>Users edit and version-control it. See <a href="/docs/configuration">Configuration</a>.</td></tr>
        <tr><td>Provider auth</td><td><code>auth.json</code> under the data root</td><td>Credentials with their own read/write path and permissions.</td></tr>
        <tr><td>Plans</td><td><code>.nikcli/plans</code> in the worktree, or <code>data/plans</code> for non-VCS sessions</td><td>Markdown meant to be read, diffed, and committed.</td></tr>
        <tr><td>Snapshots</td><td><code>data/snapshot</code></td><td>Content-addressed file trees for revert.</td></tr>
        <tr><td>Skills, commands, agents, themes</td><td>Config directories and <code>.nikcli/</code></td><td>Authored as files by users and plugins.</td></tr>
        <tr><td>Brain memory</td><td><code>.github/instructions/memory.instruction.md</code></td><td>An instruction file the model reads. See <a href="/docs/brain">Brain</a>.</td></tr>
        <tr><td>Logs</td><td><code>data/log</code></td><td>Append-only and read with ordinary tooling.</td></tr>
      </tbody>
    </table>
  </section>

  <section id="operational-checks" class="doc-section">
    <h2>Operational checks</h2>
    <DocCode language="bash">
nikcli debug paths

DB="$HOME/.local/share/nikcli/nikcli.db"
sqlite3 "$DB" ".tables"
sqlite3 "$DB" "select id, time_completed from migration order by id;"
sqlite3 "$DB" "select count(*) from session_info;"
sqlite3 "$DB" "select id, name, expires_at from mobile_tokens;"
sqlite3 "$DB" "pragma integrity_check;"
    </DocCode>
    <p>
      On macOS and Linux the default data root follows the XDG data location; on Windows it is the
      nikcli directory under Local AppData. If <code>NIKCLI_DATA_DIR</code> or <code>NIKCLI_DB</code>
      is set, inspect that path instead.
    </p>
  </section>

  <section id="failure-modes" class="doc-section">
    <h2>Failure modes</h2>
    <table class="doc-table">
      <thead><tr><th>Symptom</th><th>Likely cause</th><th>Fix</th></tr></thead>
      <tbody>
        <tr><td>Session list is empty</td><td>Wrong data root, or sessions belong to a different project/worktree.</td><td><code>nikcli debug paths</code>, then query <code>session_info</code> for the project id you expect.</td></tr>
        <tr><td>Sessions vanished after upgrading</td><td>The JSON import migration did not run — usually a different <code>NIKCLI_DATA_DIR</code> than the old install used.</td><td>Point the data root at the old location and restart so the import migration sees <code>data/storage</code>.</td></tr>
        <tr><td>Startup throws from a migration</td><td>A migration failed and rolled back; it will retry on every open.</td><td>Read the <code>database-migration</code> log lines, fix the source data or permissions, restart.</td></tr>
        <tr><td>Writes wait or fail</td><td>Another process holds the write lock past <code>busy_timeout</code>, or the file is on a filesystem that does not do WAL cleanly.</td><td>Close competing processes; move the data root to a local filesystem.</td></tr>
        <tr><td>Database is locked in tests</td><td>A stray <code>nikcli</code> binary is still running against the same file.</td><td>Kill leftover processes, remove <code>dist/</code>, re-run the file alone.</td></tr>
        <tr><td>Mobile token works once then fails</td><td>Token expired or was revoked.</td><td><code>nikcli mobile token list</code>, then issue a new token.</td></tr>
        <tr><td>Manual SQL edits are not visible</td><td>The process holds an open connection with its own page cache.</td><td>Restart the process after editing the database out of band.</td></tr>
      </tbody>
    </table>
  </section>

  <section id="source-anchors" class="doc-section">
    <h2>Source anchors</h2>
    <table class="doc-table">
      <thead><tr><th>File</th><th>What to inspect</th></tr></thead>
      <tbody>
        <tr><td><code>packages/nikcli/src/database/database.ts</code></td><td>Filename resolution, PRAGMAs, singleton client, transactions, post-commit effects, WAL checkpoint loop.</td></tr>
        <tr><td><code>packages/nikcli/src/database/schema.ts</code></td><td>The complete table surface, re-exported from every domain module.</td></tr>
        <tr><td><code>packages/nikcli/src/database/migration.ts</code></td><td>Migration table, applied-id set, transactional apply loop.</td></tr>
        <tr><td><code>packages/nikcli/src/database/migration/</code></td><td>The migrations themselves, including the legacy JSON and per-domain database imports.</td></tr>
        <tr><td><code>@nikcli-ai/util/global</code></td><td>XDG/AppData path resolution, <code>NIKCLI_DATA_DIR</code>, <code>NIKCLI_TEST_HOME</code>, cache versioning.</td></tr>
        <tr><td><code>packages/nikcli/src/session/repo.ts</code>, <code>session.sql.ts</code></td><td>The canonical repository + schema pair, including the hot-column/JSON-blob split.</td></tr>
        <tr><td><code>packages/nikcli/src/session/message-repo.ts</code>, <code>message.sql.ts</code></td><td>Message and part persistence.</td></tr>
        <tr><td><code>packages/nikcli/src/session/v2/</code></td><td>The event-sourced entry log and its persisted projection. See <a href="/docs/sessions">Sessions</a>.</td></tr>
        <tr><td><code>packages/nikcli/src/sync/</code></td><td>Event journal, projectors, snapshots, and the idempotent outbox. See <a href="/docs/sync">Sync</a>.</td></tr>
        <tr><td><code>packages/nikcli/src/mobile/auth.ts</code>, <code>auth.sql.ts</code></td><td>Mobile token hashing, caching, and bearer parsing.</td></tr>
        <tr><td><code>packages/nikcli/src/workspace/workspace.sql.ts</code></td><td>Workspace records, targets, and status.</td></tr>
      </tbody>
    </table>
  </section>
</DocsLayout>
