---
export const prerender = true

import DocsLayout from "../../layouts/DocsLayout.astro";
import DocCallout from "../../components/docs/DocCallout.astro";
import DocCode from "../../components/docs/DocCode.astro";
import DocCard from "../../components/docs/DocCard.astro";
import DocRelated from "../../components/docs/DocRelated.astro";

const related = [
  { title: "Tools", href: "/docs/tools", description: "The tool surface that permission rules gate." },
  { title: "Agents", href: "/docs/agents", description: "Per-agent permission overlays and the TUI presets that write them." },
  { title: "Configuration", href: "/docs/configuration", description: "Config form, env flags, and the legacy tools → permission migration." },
  { title: "TUI", href: "/docs/tui", description: "The permission_mode keybind and the dialog that applies a preset." },
];

const toc = [
  { title: "Overview", href: "#overview", depth: 2 },
  { title: "Permission modes", href: "#modes", depth: 2 },
  { title: "Actions and rules", href: "#actions-rules", depth: 2 },
  { title: "Config forms", href: "#config-forms", depth: 2 },
  { title: "Evaluation order", href: "#evaluation", depth: 2 },
  { title: "Ask and reply lifecycle", href: "#lifecycle", depth: 2 },
  { title: "Always approvals", href: "#always", depth: 2 },
  { title: "Tool integration", href: "#tools", depth: 2 },
  { title: "API and mobile approvals", href: "#api-mobile", depth: 2 },
  { title: "Common policies", href: "#policies", depth: 2 },
  { title: "Failure modes", href: "#failure-modes", depth: 2 },
  { title: "Source anchors", href: "#source-anchors", depth: 2 },
];
---

<DocsLayout
  title="Permissions"
  subtitle="Choose a permission mode, or customize allow, ask, and deny rules for every tool."
  description="Reference for nikcli permission modes, rules, approval persistence, tool gating, and pending request flows."
  toc={toc}
>
  <section id="overview" class="doc-section">
    <h2>Overview</h2>
    <p>
      Permissions are implemented by <code>packages/nikcli/src/permission/next.ts</code>. The
      service combines config rules with persisted project approvals, evaluates wildcard matches,
      publishes pending requests, and resolves tool execution only after the user replies.
    </p>
    <div class="doc-grid not-prose">
      <DocCard title="Config rules" eyebrow="Static">
        <p>Rules come from <code>config.permission</code> and legacy <code>tools</code> conversion.</p>
      </DocCard>
      <DocCard title="Pending requests" eyebrow="Live">
        <p>Ask actions create <code>per*</code> requests stored in memory and broadcast through bus events.</p>
      </DocCard>
      <DocCard title="Always allow" eyebrow="Durable">
        <p>Always replies append allow rules to project storage under <code>permission/:projectID</code>.</p>
      </DocCard>
      <DocCard title="Clients" eyebrow="UI">
        <p>TUI, mobile, and API clients list and reply to pending permission requests.</p>
      </DocCard>
    </div>
  </section>

  <section id="modes" class="doc-section">
    <h2>Permission modes</h2>
    <p>
      The TUI and mobile app surface three named presets plus a derived <strong>Custom</strong> label.
      Open the TUI command palette and choose <strong>Permissions</strong>, or use the
      <code>permission_mode</code> keybind, to switch modes. A preset writes the current primary
      agent's <code>permission</code> map; agent-level settings take precedence over the global
      <code>config.permission</code> value. The same preset definitions are shared by mobile and web
      through <code>permission-presets.ts</code>.
    </p>
    <table class="doc-table">
      <thead><tr><th>Mode</th><th>Short label</th><th>Behavior</th></tr></thead>
      <tbody>
        <tr>
          <td><strong>Require approval</strong> (<code>require_approval</code>)</td>
          <td><code>Ask</code></td>
          <td>Ask before every tool action.</td>
        </tr>
        <tr>
          <td><strong>Approve for me</strong> (<code>approve_for_me</code>)</td>
          <td><code>Approve</code></td>
          <td>Automatically allows trusted local work, but asks for shell commands, internet access, external files, sensitive reads, and other high-impact capabilities.</td>
        </tr>
        <tr>
          <td><strong>Full access</strong> (<code>full_access</code>)</td>
          <td><code>Full</code></td>
          <td>Allow tool actions without approval prompts.</td>
        </tr>
        <tr>
          <td><strong>Custom</strong> (<code>custom</code>)</td>
          <td><code>Custom</code></td>
          <td>Shown when individual tool rules no longer match a built-in preset.</td>
        </tr>
      </tbody>
    </table>
    <DocCallout type="note" title="Default mode">
      <p>
        An empty permission map is detected as <strong>Approve for me</strong>. This balances
        uninterrupted local editing and code navigation with explicit approval for riskier actions.
      </p>
    </DocCallout>
    <h3>Approve for me defaults</h3>
    <table class="doc-table">
      <thead><tr><th>Action</th><th>Tools and capabilities</th></tr></thead>
      <tbody>
        <tr><td><code>allow</code></td><td>Local editing and navigation, tasks and skills, LSP, todos, repository overview, context queries, RAG search/status, and speech.</td></tr>
        <tr><td><code>ask</code></td><td><code>bash</code>, web fetch/search/code search, external directories, browser and computer control, repository cloning, image generation, memory search, RAG indexing/reset, doom-loop approval, and reads of <code>*.env</code> or <code>*.env.*</code>. <code>*.env.example</code> remains allowed.</td></tr>
        <tr><td><code>deny</code></td><td>Internal <code>question</code>, <code>plan_enter</code>, and <code>plan_exit</code> permission keys.</td></tr>
      </tbody>
    </table>
    <p>
      Selecting an individual tool cycles its action through <code>allow</code>, <code>ask</code>, and
      <code>deny</code>. The mode then appears as <strong>Custom</strong> unless the resulting map still
      matches one of the presets. A preset is just a starting map; once it lands in
      <code>config.permission</code> (or in an agent-level override), the ruleset evaluator treats it
      the same as a hand-written <code>permission</code> object.
    </p>
    <DocCallout type="info" title="How a preset becomes rules">
      <p>
        Each preset is converted to the same <code>permission</code> map shape described in
        <a href="#config-forms">Config forms</a>. <code>require_approval</code> writes
        <code>&#123;"*": "ask"&#125;</code> for every known tool; <code>full_access</code> writes
        <code>&#123;"*": "allow"&#125;</code>; <code>approve_for_me</code> writes the explicit allow,
        ask, and deny map shown above. Internal keys (<code>question</code>, <code>plan_enter</code>,
        <code>plan_exit</code>) are always <code>deny</code> so the agent cannot bypass the
        permission pipeline through them.
      </p>
    </DocCallout>
  </section>

  <section id="actions-rules" class="doc-section">
    <h2>Actions and rules</h2>
    <table class="doc-table">
      <thead><tr><th>Action</th><th>Behavior</th></tr></thead>
      <tbody>
        <tr><td><code>allow</code></td><td>Tool execution proceeds without prompting when permission and pattern match.</td></tr>
        <tr><td><code>deny</code></td><td>Tool execution fails immediately with <code>PermissionNext.DeniedError</code>.</td></tr>
        <tr><td><code>ask</code></td><td>A pending request is created and execution waits for a reply.</td></tr>
      </tbody>
    </table>
    <p>
      A rule has <code>permission</code>, <code>pattern</code>, and <code>action</code>. The permission
      is a tool or capability name. The pattern is tool-specific: command text for bash, file paths
      for edit/read-style tools, or <code>*</code> for capability-wide matching.
    </p>
  </section>

  <section id="config-forms" class="doc-section">
    <h2>Config forms</h2>
    <p>The schema accepts three useful forms:</p>
    <DocCode language="json" title="permission config">
&#123;
  "permission": "ask"
&#125;
    </DocCode>
    <DocCode language="json" title="tool action map">
&#123;
  "permission": &#123;
    "bash": "ask",
    "edit": "ask",
    "webfetch": "ask",
    "lsp": "ask"
  &#125;
&#125;
    </DocCode>
    <DocCode language="json" title="pattern map">
&#123;
  "permission": &#123;
    "bash": &#123;
      "git status*": "allow",
      "git diff*": "allow",
      "rm *": "deny",
      "*": "ask"
    &#125;,
    "edit": &#123;
      "src/**": "ask",
      "package.json": "ask",
      ".env*": "deny"
    &#125;
  &#125;
&#125;
    </DocCode>
    <DocCallout type="note" title="Home expansion">
      <p>
        Patterns that start with <code>~/</code>, <code>~</code>, or <code>$HOME</code> are expanded
        to the user's home directory when config is converted to rules.
      </p>
    </DocCallout>
  </section>

  <section id="evaluation" class="doc-section">
    <h2>Evaluation order</h2>
    <p>
      <code>PermissionNext.evaluate</code> merges all rulesets and uses the last matching rule.
      A rule matches only when both the permission wildcard and the pattern wildcard match. If no
      rule matches, the fallback action is <code>ask</code>.
    </p>
    <ol>
      <li>Config permission is converted with <code>PermissionNext.fromConfig</code>.</li>
      <li>Persisted project approvals are loaded from storage.</li>
      <li>Tool-specific extra rules can be merged by callers.</li>
      <li>The service uses <code>findLast</code>, so later rules override earlier matching rules.</li>
      <li>For each requested pattern, deny fails, ask prompts, allow continues.</li>
    </ol>
    <table class="doc-table">
      <thead><tr><th>Rule set</th><th>Persistence</th><th>Typical source</th></tr></thead>
      <tbody>
        <tr><td>Config rules</td><td>Config files and env content</td><td><code>permission</code> field.</td></tr>
        <tr><td>Always approvals</td><td><code>storage/permission/:projectID</code></td><td>User clicked or tapped always allow.</td></tr>
        <tr><td>Extra runtime rules</td><td>In-memory for the ask call</td><td>Tool or session-specific constraints.</td></tr>
      </tbody>
    </table>
  </section>

  <section id="lifecycle" class="doc-section">
    <h2>Ask and reply lifecycle</h2>
    <ol>
      <li>A tool calls <code>ctx.ask</code> or directly reaches <code>PermissionNext.ask</code>.</li>
      <li>The request is parsed and assigned a permission id if none was supplied.</li>
      <li>Each requested pattern is evaluated against config and stored approvals.</li>
      <li>A deny immediately rejects execution.</li>
      <li>An ask stores a pending request and publishes <code>permission.asked</code>.</li>
      <li>The TUI, mobile app, or API client lists pending requests and sends a reply.</li>
      <li>The reply publishes <code>permission.replied</code> and resolves, rejects, or persists approvals.</li>
    </ol>
    <table class="doc-table">
      <thead><tr><th>Reply</th><th>Effect</th></tr></thead>
      <tbody>
        <tr><td><code>once</code></td><td>Resolve only the current pending request.</td></tr>
        <tr><td><code>always</code></td><td>Append allow rules for the request's <code>always</code> patterns, persist them, then auto-resolve same-session requests that now match.</td></tr>
        <tr><td><code>reject</code></td><td>Reject the request. If feedback text is supplied, the tool sees a correction error. Other pending requests in the same session are rejected too.</td></tr>
      </tbody>
    </table>
  </section>

  <section id="always" class="doc-section">
    <h2>Always approvals</h2>
    <p>
      Always approvals are scoped to the current project id. They are not written into
      <code>nikcli.json</code>. They live in the JSON storage service under a permission key and are
      loaded into the permission service state when the project instance starts.
    </p>
    <DocCallout type="warn" title="Always does not mean global">
      <p>
        The persisted approval belongs to the current project. Another repo or project id does not
        automatically inherit the same always approval.
      </p>
    </DocCallout>
  </section>

  <section id="tools" class="doc-section">
    <h2>Tool integration</h2>
    <p>Different tools provide different patterns and always scopes.</p>
    <table class="doc-table">
      <thead><tr><th>Permission</th><th>Typical pattern</th><th>Notes</th></tr></thead>
      <tbody>
        <tr><td><code>bash</code></td><td>Command text or command prefix</td><td>Use narrow allow rules for harmless commands and ask/deny for destructive commands.</td></tr>
        <tr><td><code>edit</code></td><td>File path</td><td>Used by write/edit/patch-style tools.</td></tr>
        <tr><td><code>external_directory</code></td><td>Path outside project</td><td>Guards reads/writes outside the current worktree.</td></tr>
        <tr><td><code>webfetch</code>, <code>websearch</code></td><td>URL or wildcard</td><td>Network-related tools can be forced to ask.</td></tr>
        <tr><td><code>lsp</code></td><td><code>*</code></td><td>The LSP tool asks before running language-server operations.</td></tr>
        <tr><td><code>task</code></td><td>Task or wildcard</td><td>Controls delegated work launched by the <code>task</code> tool (subagents inherit the parent session's permission map).</td></tr>
        <tr><td><code>generate_image</code>, <code>speak</code></td><td>Provider/model or wildcard</td><td>Media generation tools can be separately controlled.</td></tr>
      </tbody>
    </table>
  </section>

  <section id="api-mobile" class="doc-section">
    <h2>API and mobile approvals</h2>
    <p>
      Pending permissions are exposed by classic routes and typed HttpApi routes. Mobile routes
      expose the same request/reply behavior inside the session composer approval controls.
    </p>
    <table class="doc-table">
      <thead><tr><th>Surface</th><th>Source</th><th>Behavior</th></tr></thead>
      <tbody>
        <tr><td>Classic API</td><td><code>server/routes/permission.ts</code></td><td>List pending requests and reply.</td></tr>
        <tr><td>Typed API</td><td><code>server/httpapi/permission.ts</code></td><td>Effect HttpApi list and reply endpoints.</td></tr>
        <tr><td>TUI</td><td><code>cli/cmd/tui/routes/session/permission.tsx</code></td><td>Shows inline permission prompts in root sessions.</td></tr>
        <tr><td>Mobile</td><td><code>server/routes/mobile.ts</code> and mobile composer components</td><td>Displays approval bars and sends replies from the phone.</td></tr>
      </tbody>
    </table>
    <DocCode language="bash">
curl http://127.0.0.1:4096/permission

curl -X POST http://127.0.0.1:4096/permission/per_example/reply \
  -H "Content-Type: application/json" \
  -d '&#123;"reply":"once"&#125;'
    </DocCode>
  </section>

  <section id="policies" class="doc-section">
    <h2>Common policies</h2>
    <table class="doc-table">
      <thead><tr><th>Goal</th><th>Policy</th></tr></thead>
      <tbody>
        <tr><td>Strict by default</td><td>Apply the <strong>Require approval</strong> preset (<code>require_approval</code>).</td></tr>
        <tr><td>Balanced local work</td><td>Apply the <strong>Approve for me</strong> preset (<code>approve_for_me</code>) — the empty-map default.</td></tr>
        <tr><td>Run unattended in a sandbox</td><td>Apply the <strong>Full access</strong> preset (<code>full_access</code>); internal keys stay <code>deny</code>.</td></tr>
        <tr><td>Ask before all shell and edits</td><td><code>bash: ask</code>, <code>edit: ask</code>.</td></tr>
        <tr><td>Allow harmless git reads</td><td>Allow <code>git status*</code>, <code>git diff*</code>, <code>git log*</code>; ask for all other bash.</td></tr>
        <tr><td>Protect secrets</td><td>Deny edit/read patterns such as <code>.env*</code> where appropriate.</td></tr>
        <tr><td>Disable browsing</td><td>Set <code>webfetch</code> and <code>websearch</code> to <code>deny</code>.</td></tr>
        <tr><td>Allow language queries</td><td>Set <code>lsp</code> to <code>allow</code> for trusted projects.</td></tr>
        <tr><td>Keep delegated work explicit</td><td>Set <code>task</code> to <code>ask</code> so the <code>task</code> tool prompts before launching a subagent.</td></tr>
      </tbody>
    </table>
  </section>

  <section id="failure-modes" class="doc-section">
    <h2>Failure modes</h2>
    <table class="doc-table">
      <thead><tr><th>Symptom</th><th>Likely cause</th><th>Fix</th></tr></thead>
      <tbody>
        <tr><td>Allowed command still asks</td><td>The command pattern does not match exactly or a later ask rule overrides it.</td><td>Check wildcard pattern and rule order.</td></tr>
        <tr><td>Always approval not reused</td><td>The later request uses a different pattern or different project id.</td><td>Inspect the request's <code>always</code> patterns and current project.</td></tr>
        <tr><td>Reject cancels more than one prompt</td><td>Reject intentionally rejects other pending requests in the same session.</td><td>Use once/always for approval; reject only when the session should stop that work.</td></tr>
        <tr><td>Legacy tools config behaves differently</td><td><code>tools</code> booleans are converted to permission actions, with write/edit/patch aliases mapped to <code>edit</code>.</td><td>Migrate to explicit <code>permission</code> config.</td></tr>
        <tr><td>Mobile shows no approval</td><td>The request belongs to a child session or was already hydrated/replied.</td><td>Check root session aggregation and pending permission list.</td></tr>
      </tbody>
    </table>
  </section>

  <section id="source-anchors" class="doc-section">
    <h2>Source anchors</h2>
    <table class="doc-table">
      <thead><tr><th>Need</th><th>File</th></tr></thead>
      <tbody>
        <tr><td>Permission service</td><td><code>packages/nikcli/src/permission/next.ts</code></td></tr>
        <tr><td>Compatibility exports</td><td><code>packages/nikcli/src/permission/evaluate.ts</code></td></tr>
        <tr><td>Permission schema</td><td><code>packages/nikcli/src/permission/schema.ts</code></td></tr>
        <tr><td>Config permission schema and legacy tools migration</td><td><code>packages/nikcli/src/config/config.ts</code></td></tr>
        <tr><td>API routes</td><td><code>packages/nikcli/src/server/routes/permission.ts</code>, <code>packages/nikcli/src/server/httpapi/permission.ts</code></td></tr>
        <tr><td>TUI permission mode dialog</td><td><code>packages/nikcli/src/cli/cmd/tui/component/dialog-permission-mode.tsx</code></td></tr>
        <tr><td>TUI preset definitions and mode detection</td><td><code>packages/nikcli/src/cli/cmd/tui/util/permission-presets.ts</code></td></tr>
        <tr><td>Mobile preset definitions and mode detection</td><td><code>packages/mobile/lib/permission-presets.ts</code></td></tr>
        <tr><td>TUI permission prompt</td><td><code>packages/nikcli/src/cli/cmd/tui/routes/session/permission.tsx</code></td></tr>
        <tr><td>LSP tool permission example</td><td><code>packages/nikcli/src/tool/lsp.ts</code></td></tr>
      </tbody>
    </table>
  </section>

  <DocRelated links={related} />
</DocsLayout>
