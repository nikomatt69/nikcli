const topFields = [
  { key: "$schema", desc: "Schema URL for validation." },
  { key: "theme", desc: "Theme name for the UI." },
  { key: "logLevel", desc: "Log level (DEBUG/INFO/WARN/ERROR)." },
  { key: "tui", desc: "TUI settings such as scroll and layout behavior." },
  { key: "server", desc: "Server defaults for serve and web commands." },
  { key: "remote", desc: "Remote session defaults and tunnel behavior." },
  { key: "command", desc: "Command templates and presets." },
  { key: "watcher", desc: "File watcher ignore rules." },
  { key: "plugin", desc: "Plugin entrypoints to load." },
  { key: "snapshot", desc: "Enable snapshot tracking." },
  { key: "share", desc: "manual | auto | disabled." },
  { key: "autoupdate", desc: "true | false | notify." },
  { key: "disabled_providers", desc: "Disable providers by ID." },
  { key: "enabled_providers", desc: "Enable only these providers." },
  { key: "model", desc: "Default model in provider/model format." },
  { key: "small_model", desc: "Small model for titles and summaries." },
  { key: "default_agent", desc: "Primary agent name." },
  { key: "username", desc: "Custom username label." },
  { key: "agent", desc: "Agent configuration objects." },
  { key: "provider", desc: "Provider config overrides." },
  { key: "mcp", desc: "MCP server configs." },
  { key: "connectors", desc: "External service connectors and auth targets." },
  { key: "formatter", desc: "Formatter config or false." },
  { key: "lsp", desc: "LSP config or false." },
  { key: "instructions", desc: "Extra instruction files or patterns." },
  { key: "permission", desc: "Permission ruleset." },
  { key: "tools", desc: "Legacy tool allow/deny map." },
  { key: "enterprise", desc: "Enterprise settings." },
  { key: "compaction", desc: "Auto compaction settings." },
  { key: "experimental", desc: "Experimental flags, hooks, and feature toggles." },
  { key: "image", desc: "Image generation defaults." },
  { key: "speak", desc: "Text-to-speech defaults." },
  { key: "notifications", desc: "Todo and general notification settings." },
  { key: "mobile", desc: "Mobile development settings including Tophat." },
];
---

<DocsLayout
  title="Configuration"
  subtitle="Config resolution and schema reference derived from packages/nikcli/src/config/config.ts."
  toc={toc}
>
  <section id="resolution-order" class="mb-16 scroll-mt-24">
    <h2>Resolution Order</h2>
    <p>Configuration is merged in the following precedence order (lowest to highest):</p>
    <table class="doc-table">
      <thead>
        <tr>
          <th>Layer</th>
          <th>Source</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Remote</td><td><code>/.well-known/nikcli</code> for compatible OAuth providers.</td></tr>
        <tr><td>Global</td><td><code>~/.config/nikcli/nikcli.jsonc</code> and sibling config names.</td></tr>
        <tr><td>Custom path</td><td><code>NIKCLI_CONFIG</code> — path to an additional config file.</td></tr>
        <tr><td>Project</td><td><code>nikcli.jsonc</code> or <code>nikcli.json</code> discovered upward.</td></tr>
        <tr><td>Inline content</td><td><code>NIKCLI_CONFIG_CONTENT</code> — highest precedence; inline JSON string.</td></tr>
      </tbody>
    </table>
    <DocCallout type="info" title="Config tokens">
      <p>Values like <code>{`{env:VAR}`}</code> and <code>{`{file:path}`}</code> are expanded while parsing.</p>
    </DocCallout>
  </section>

  <section id="config-schema" class="mb-16 scroll-mt-24">
    <h2>Config Schema</h2>
    <DocCode language="json">
{`{
  "$schema": "https://nikcli.store/config.json",
  "model": "anthropic/claude-sonnet-4-20250514",
  "small_model": "anthropic/claude-haiku-4-20250514",
  "default_agent": "build",
  "share": "manual",
  "provider": {
    "anthropic": { "options": { "apiKey": "{env:ANTHROPIC_API_KEY}" } }
  },
  "connectors": {
    "github": { "type": "github", "enabled": true }
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
    }
  },
  "image": {
    "provider": "openrouter",
    "model": "openai/gpt-5-image"
  },
  "speak": {
    "provider": "elevenlabs",
    "model": "YOq2y2Up4RgXP2HyXjE5"
  },
  "notifications": {
    "todo": { "enabled": true },
    "notify": { "enabled": true, "events": { "permissionAsked": true } }
  },
  "mobile": {
    "tophat": { "enabled": true, "defaultPlatform": "ios" }
  },
  "experimental": {
    "primary_tools": ["bash", "task"],
    "brain": true,
    "memory": true
  }
}`}
    </DocCode>
  </section>

  <section id="top-level-fields" class="mb-16 scroll-mt-24">
    <h2>Top-Level Fields</h2>
    <table class="doc-table">
      <thead>
        <tr>
          <th>Field</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {topFields.map((field) => (
          <tr>
            <td><code>{field.key}</code></td>
            <td>{field.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section id="providers-connectors" class="mb-16 scroll-mt-24">
    <h2>Providers & Connectors</h2>
    <p>
      Providers live under <code>provider</code>, MCP servers under <code>mcp</code>, and external
      service integrations under <code>connectors</code>.
    </p>
    <DocCode language="json">
{`{
  "provider": {
    "openai": { "options": { "apiKey": "{env:OPENAI_API_KEY}" } },
    "amazon-bedrock": { "options": { "region": "us-east-1" } }
  },
  "connectors": {
    "figma": { "type": "figma", "enabled": true },
    "slack": { "type": "slack", "enabled": true },
    "github": { "type": "github", "enabled": true }
  },
  "mcp": {
    "remote-docs": { "type": "remote", "url": "https://example.com/mcp" }
  }
}`}
    </DocCode>
  </section>

  <section id="image-speak" class="mb-16 scroll-mt-24">
    <h2>Image & Speak</h2>
    <DocCode language="json">
{`{
  "image": { "provider": "openrouter", "model": "openai/gpt-5-image" },
  "speak": { "provider": "elevenlabs", "model": "YOq2y2Up4RgXP2HyXjE5" }
}`}
    </DocCode>
  </section>

  <section id="notifications-mobile" class="mb-16 scroll-mt-24">
    <h2>Notifications & Mobile</h2>
    <DocCode language="json">
{`{
  "notifications": {
    "todo": {
      "enabled": true,
      "slack": { "enabled": true, "connector": "slack", "channel": "#builds" }
    },
    "notify": {
      "enabled": true,
      "events": { "sessionIdle": true, "permissionAsked": true }
    }
  },
  "mobile": {
    "tophat": {
      "enabled": true,
      "defaultPlatform": "ios",
      "defaultDestination": "simulator"
    }
  }
}`}
    </DocCode>
  </section>

  <section id="keybinds" class="mb-16 scroll-mt-24">
    <h2>Keybinds</h2>
    <p>Default keybinds are defined in <code>KeybindsConfig</code> and can be overridden under <code>keybinds</code>.</p>
    <table class="doc-table">
      <thead>
        <tr>
          <th>Key</th>
          <th>Default</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {keybinds.map((item) => (
          <tr>
            <td><code>{item.key}</code></td>
            <td><code>{item.default}</code></td>
            <td>{item.describe}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section id="flags-env" class="mb-16 scroll-mt-24">
    <h2>Flags & Env</h2>
    <p>Runtime flags are parsed from environment variables in <code>packages/nikcli/src/flag/flag.ts</code>.</p>
    <table class="doc-table">
      <thead>
        <tr>
          <th>Variable</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {flags.map((flag) => (
          <tr>
            <td><code>{flag.key}</code></td>
            <td>{flag.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section id="experimental" class="mb-16 scroll-mt-24">
    <h2>Experimental</h2>
    <p>
      The <code>experimental</code> block now includes higher-level features such as
      <code>primary_tools</code>, <code>brain</code>, <code>memory</code>, hook configuration, and
      other runtime toggles in addition to env-gated flags.
    </p>
  </section>
</DocsLayout>
