---
import DocsLayout from "../../layouts/DocsLayout.astro";
import DocCallout from "../../components/docs/DocCallout.astro";
import DocCode from "../../components/docs/DocCode.astro";
import { keybinds } from "../../data/keybinds";

const toc = [
  { title: "Resolution Order", href: "#resolution-order", depth: 2 },
  { title: "Config Schema", href: "#config-schema", depth: 2 },
  { title: "Top-Level Fields", href: "#top-level-fields", depth: 2 },
  { title: "Providers & Connectors", href: "#providers-connectors", depth: 2 },
  { title: "Image & Speak", href: "#image-speak", depth: 2 },
  { title: "Notifications & Mobile", href: "#notifications-mobile", depth: 2 },
  { title: "Keybinds", href: "#keybinds", depth: 2 },
  { title: "Flags & Env", href: "#flags-env", depth: 2 },
  { title: "Experimental", href: "#experimental", depth: 2 },
];

const flags = [
