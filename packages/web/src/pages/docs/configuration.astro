  { key: "NIKCLI_CONFIG", desc: "Custom config file path." },
  { key: "NIKCLI_CONFIG_DIR", desc: "Additional config directory to scan." },
  { key: "NIKCLI_CONFIG_CONTENT", desc: "Inline JSON config content." },
  { key: "NIKCLI_DISABLE_AUTOUPDATE", desc: "Disable automatic upgrades." },
  { key: "NIKCLI_DISABLE_PRUNE", desc: "Disable pruning of old tool outputs." },
  { key: "NIKCLI_DISABLE_TERMINAL_TITLE", desc: "Disable terminal title updates." },
  { key: "NIKCLI_PERMISSION", desc: "Inline JSON permission overrides." },
  { key: "NIKCLI_DISABLE_DEFAULT_PLUGINS", desc: "Skip built-in plugins." },
  { key: "NIKCLI_DISABLE_LSP_DOWNLOAD", desc: "Disable automatic LSP downloads." },
  { key: "NIKCLI_ENABLE_EXPERIMENTAL_MODELS", desc: "Allow experimental models from catalog." },
  { key: "NIKCLI_DISABLE_AUTOCOMPACT", desc: "Disable auto compaction." },
  { key: "NIKCLI_DISABLE_MODELS_FETCH", desc: "Disable models.dev fetch." },
  { key: "NIKCLI_DISABLE_CLAUDE_CODE", desc: "Disable Claude Code integrations." },
  { key: "NIKCLI_DISABLE_CLAUDE_CODE_PROMPT", desc: "Disable Claude Code prompt injection." },
  { key: "NIKCLI_DISABLE_CLAUDE_CODE_SKILLS", desc: "Disable Claude Code skills discovery." },
  { key: "NIKCLI_DISABLE_PROJECT_CONFIG", desc: "Disable project-level config discovery." },
  { key: "NIKCLI_FAKE_VCS", desc: "Force fake VCS mode." },
  { key: "NIKCLI_CLIENT", desc: "Client type (cli/app/desktop)." },
  { key: "NIKCLI_SERVER_PASSWORD", desc: "Enable basic auth for server mode." },
  { key: "NIKCLI_SERVER_USERNAME", desc: "Override basic auth username." },
  { key: "NIKCLI_EXPERIMENTAL", desc: "Enable experimental features." },
  { key: "NIKCLI_EXPERIMENTAL_FILEWATCHER", desc: "Enable experimental file watcher." },
  { key: "NIKCLI_EXPERIMENTAL_DISABLE_FILEWATCHER", desc: "Disable file watcher." },
  { key: "NIKCLI_EXPERIMENTAL_ICON_DISCOVERY", desc: "Enable icon discovery." },
  { key: "NIKCLI_EXPERIMENTAL_DISABLE_COPY_ON_SELECT", desc: "Disable copy-on-select." },
  { key: "NIKCLI_ENABLE_EXA", desc: "Enable Exa-backed search tools." },
  { key: "NIKCLI_EXPERIMENTAL_EXA", desc: "Enable Exa search in experimental mode." },
  { key: "NIKCLI_EXPERIMENTAL_BASH_MAX_OUTPUT_LENGTH", desc: "Max bash output length." },
  { key: "NIKCLI_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS", desc: "Default bash timeout in ms." },
  { key: "NIKCLI_EXPERIMENTAL_OUTPUT_TOKEN_MAX", desc: "Max output tokens before truncation." },
  { key: "NIKCLI_EXPERIMENTAL_OXFMT", desc: "Enable experimental formatter." },
  { key: "NIKCLI_EXPERIMENTAL_LSP_TY", desc: "Enable experimental LSP server ty." },
