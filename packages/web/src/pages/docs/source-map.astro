        <tr><td>Config</td><td><code>server/routes/config.ts</code></td><td><code>server/httpapi/config.ts</code></td></tr>
        <tr><td>Workspace</td><td><code>server/routes/workspace.ts</code></td><td><code>server/httpapi/workspace.ts</code></td></tr>
