        <tr><td>File</td><td><code>server/routes/file.ts</code></td><td><code>server/httpapi/file.ts</code></td></tr>
        <tr><td>Provider</td><td><code>server/routes/provider.ts</code></td><td><code>server/httpapi/provider.ts</code></td></tr>
