        <tr><td><code>mcp</code></td><td><code>cli/cmd/mcp.ts</code></td><td>MCP config, OAuth, list, debug, logout.</td></tr>
        <tr><td><code>connectors</code></td><td><code>cli/cmd/connectors.ts</code></td><td>External service config and credentials.</td></tr>
        <tr><td><code>plugin</code> / <code>plug</code></td><td><code>cli/cmd/plug.ts</code></td><td>Plugin install, manifest read, config patch.</td></tr>
        <tr><td><code>models</code></td><td><code>cli/cmd/models.ts</code></td><td>Provider/model catalog.</td></tr>
        <tr><td><code>debug</code></td><td><code>cli/cmd/debug</code></td><td>Config, LSP, skill, snapshot, search, file utilities.</td></tr>
        <tr><td><code>routine</code></td><td><code>cli/cmd/routine.ts</code></td><td>Routine CRUD, run, pause, resume.</td></tr>
