        <tr><td>Command palette</td><td><code>cli/cmd/tui/component/dialog-command.tsx</code></td></tr>
        <tr><td>Remote control</td><td><code>server/routes/tui.ts</code>, <code>cli/cmd/tui/event.ts</code></td></tr>
        <tr><td>Plugin runtime</td><td><code>cli/cmd/tui/plugin/runtime.ts</code>, <code>plugin/api.tsx</code></td></tr>
