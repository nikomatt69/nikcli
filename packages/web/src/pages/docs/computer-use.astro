const toc = [
  { title: "Overview", href: "#overview", depth: 2 },
  { title: "Why a separate package", href: "#why", depth: 2 },
  { title: "Install & skill", href: "#install", depth: 2 },
  { title: "Session lifecycle", href: "#sessions", depth: 2 },
  { title: "Backends", href: "#backends", depth: 2 },
