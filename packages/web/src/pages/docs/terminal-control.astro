import DocCode from "../../components/docs/DocCode.astro";

const toc = [
  { title: "Overview", href: "#overview", depth: 2 },
  { title: "How it differs from browser-control", href: "#vs-browser", depth: 2 },
  { title: "CLI surface", href: "#cli", depth: 2 },
  { title: "Bundle command", href: "#bundle", depth: 2 },
