        <tr><td>Notifications (master + per-kind)</td><td>Off / on per kind</td><td>Interaction → Notifications</td></tr>
        <tr><td>Haptics (master + send/commands/permissions/errors)</td><td>On</td><td>Interaction → Haptics</td></tr>
        <tr><td>Message gestures (swipe / long-press)</td><td>On</td><td>Interaction → Message gestures</td></tr>
        <tr><td>Composer default mode</td><td>Code</td><td>Commands → Composer defaults</td></tr>
        <tr><td>Auto-follow transcript</td><td>On</td><td>Commands → Composer defaults</td></tr>
        <tr><td>Slash suggestions</td><td>On</td><td>Commands → Composer defaults</td></tr>
        <tr><td>Visible settings sections</td><td>All visible</td><td>Appearance</td></tr>
      </tbody>
    </table>
  </section>
