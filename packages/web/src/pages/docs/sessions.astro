---
import DocsLayout from "../../layouts/DocsLayout.astro";
import DocCallout from "../../components/docs/DocCallout.astro";

const toc = [
  { title: "Session Model", href: "#session-model", depth: 2 },
  { title: "Storage & Streaming", href: "#storage-streaming", depth: 2 },
  { title: "Background Work", href: "#background-work", depth: 2 },
  { title: "Sharing & Mobile", href: "#sharing-mobile", depth: 2 },
];
---

<DocsLayout
  title="Sessions"
  subtitle="Session lifecycle, persistence, streaming, and sharing across nikcli surfaces."
  toc={toc}
>
  <section id="session-model" class="mb-16 scroll-mt-24">
    <h2>Session Model</h2>
    <p>
      The <code>Session.Info</code> schema defines session metadata, timing, sharing, permissions,
      and working-directory context. Sessions are the core unit shared by the TUI, companion UI,
      HTTP API, and mobile app.
    </p>
    <table class="doc-table">
      <thead>
        <tr>
          <th>Field</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><code>id</code></td><td>Descending identifier.</td></tr>
        <tr><td><code>slug</code></td><td>Human-friendly slug.</td></tr>
        <tr><td><code>projectID</code></td><td>Project scope identifier.</td></tr>
        <tr><td><code>directory</code></td><td>Working directory.</td></tr>
        <tr><td><code>parentID</code></td><td>Parent session (forks).</td></tr>
        <tr><td><code>summary</code></td><td>Diff stats and optional diffs list.</td></tr>
        <tr><td><code>share</code></td><td>Share URL when shared.</td></tr>
        <tr><td><code>title</code></td><td>Auto-generated when not set.</td></tr>
        <tr><td><code>time</code></td><td>created/updated/compacting/archived timestamps.</td></tr>
        <tr><td><code>workspaceID</code></td><td>Optional workspace scope.</td></tr>
        <tr><td><code>permission</code></td><td>Optional per-session permission rules.</td></tr>
        <tr><td><code>skills</code></td><td>Skill IDs active for this session.</td></tr>
        <tr><td><code>disabledInstructions</code></td><td>Instruction file paths suppressed from the system prompt.</td></tr>
        <tr><td><code>disabledTools</code></td><td>Tool IDs disabled for this session.</td></tr>
        <tr><td><code>revert</code></td><td>Snapshot revert metadata.</td></tr>
      </tbody>
    </table>
  </section>

  <section id="storage-streaming" class="mb-16 scroll-mt-24">
    <h2>Storage & Streaming</h2>
    <p>
      Sessions, messages, parts, and diffs are stored as JSON files. The same session state is also
      streamed incrementally to clients such as the companion UI and the mobile app.
    </p>
    <DocCallout type="info" title="Mobile streaming">
      <p>
        The Expo app consumes session updates over SSE in
        <code>packages/mobile/hooks/use-session-stream.ts</code>.
      </p>
    </DocCallout>
  </section>

  <section id="background-work" class="mb-16 scroll-mt-24">
    <h2>Background Work</h2>
    <table class="doc-table">
      <thead>
        <tr>
          <th>Feature</th>
          <th>Purpose</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><code>task</code> + <code>delegation</code></td><td>Launch background subagents and read or cancel their results.</td></tr>
        <tr><td><code>monitor</code></td><td>Run long-lived shell jobs with persisted logs and wake-up behavior.</td></tr>
        <tr><td><code>todowrite</code></td><td>Track structured task progress inside a session.</td></tr>
        <tr><td><code>notifications.todo</code></td><td>Emit native, Slack, or Discord notifications for todo state changes.</td></tr>
      </tbody>
    </table>
  </section>

  <section id="sharing-mobile" class="mb-16 scroll-mt-24">
    <h2>Sharing & Mobile</h2>
    <p>
      Shared sessions expose URLs that can be reopened via <code>nikcli attach</code> or the
      companion UI. The same session can also be resumed on mobile, where approvals, tool output,
      attachments, and GitHub actions are rendered against the live host session.
    </p>
  </section>
</DocsLayout>
