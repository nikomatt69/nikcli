        <tr><td><code>/config</code></td><td><code>routes/config.ts</code></td><td>Read, patch, profiles, provider/MCP config mutations.</td></tr>
        <tr><td><code>/experimental</code></td><td><code>routes/experimental.ts</code></td><td>Worktrees, tool metadata, resources, and workspace warp routes.</td></tr>
        <tr><td><code>/session</code></td><td><code>routes/session.ts</code></td><td>Session lifecycle, messages, streaming, revert, share, monitors, todos.</td></tr>
        <tr><td><code>/permission</code></td><td><code>routes/permission.ts</code></td><td>Pending permission requests and replies.</td></tr>
        <tr><td><code>/question</code></td><td><code>routes/question.ts</code></td><td>User question requests and replies.</td></tr>
        <tr><td><code>/provider</code></td><td><code>routes/provider.ts</code></td><td>Provider catalog, auth, refresh, and model metadata.</td></tr>
        <tr><td><code>/companion</code></td><td><code>routes/companion.ts</code></td><td>Companion app endpoints and embedded assets.</td></tr>
        <tr><td><code>/user</code></td><td><code>routes/users.ts</code></td><td>Local account login, registration, profile, and user admin.</td></tr>
        <tr><td><code>/mobile</code></td><td><code>routes/mobile.ts</code></td><td>Mobile bootstrap, sessions, repos, git, approvals, routines, terminals, teleport.</td></tr>
        <tr><td><code>/connectors</code></td><td><code>routes/connectors.ts</code></td><td>Connector status, auth, logout, cache invalidation.</td></tr>
        <tr><td><code>/chatbot</code></td><td><code>routes/chatbot.ts</code></td><td>Slack, Discord, Teams, Google Chat, Linear, and GitHub bot webhooks.</td></tr>
        <tr><td><code>/brain</code></td><td><code>routes/brain.ts</code></td><td>Brain model selection, periodic re-evaluation, and idle nudge scheduler state.</td></tr>
        <tr><td><code>/mission</code></td><td><code>routes/mission.ts</code></td><td>Mission list, draft, validation review, and run endpoints.</td></tr>
        <tr><td><code>/sync</code></td><td><code>routes/sync.ts</code></td><td>Hub config, stats, outbox snapshot, and push endpoint. See <a href="/docs/sync">Sync</a>.</td></tr>
        <tr><td><code>/mcp</code></td><td><code>routes/mcp.ts</code></td><td>MCP status, add, OAuth, connect, disconnect, toggle.</td></tr>
        <tr><td><code>/tui</code></td><td><code>routes/tui.ts</code></td><td>Remote control endpoints that publish TUI command events.</td></tr>
