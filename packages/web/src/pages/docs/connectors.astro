        <tr><td>Connector service</td><td><code>packages/nikcli/src/connectors/index.ts</code></td></tr>
        <tr><td>Connector registry and tools</td><td><code>packages/nikcli/src/connectors/registry.ts</code></td></tr>
        <tr><td>Credential resolution</td><td><code>packages/nikcli/src/connectors/credentials.ts</code></td></tr>
        <tr><td>Credential store</td><td><code>packages/nikcli/src/connectors/auth.ts</code></td></tr>
        <tr><td>CLI command</td><td><code>packages/nikcli/src/cli/cmd/connectors.ts</code></td></tr>
        <tr><td>Server routes</td><td><code>packages/nikcli/src/server/routes/connectors.ts</code></td></tr>
        <tr><td>Chatbot routes</td><td><code>packages/nikcli/src/server/routes/chatbot.ts</code></td></tr>
        <tr><td>Service APIs</td><td><code>packages/nikcli/src/connectors/api</code></td></tr>
      </tbody>
    </table>
  </section>
</DocsLayout>
