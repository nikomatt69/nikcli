---
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/Navbar.astro"
import { changelogEntries, renderMarkdownBlock, slugify, type ChangelogEntry } from "../lib/changelog"
import { fetchReleases, isComplete, compareVersions } from "../lib/releases"

// The authored notes live in CHANGELOG.md (bundled at build). That file is
// regenerated by a separate release step and can lag a freshly-published
// version. To stay in sync with the download page, we also pull GitHub releases
// and prepend any *complete* release (CI finished) that isn't in CHANGELOG.md
// yet, rendering its GitHub release notes. Half-published versions are skipped.
const parsed = changelogEntries
const latestParsed = parsed.find((e) => e.version)?.version ?? "0.0.0"

let releaseStubs: ChangelogEntry[] = []
try {
  const releases = await fetchReleases(15)
  const monthYear = (iso: string | null) =>
    iso ? new Date(iso).toLocaleDateString("en-US", { month: "long", year: "numeric" }) : null
  releaseStubs = releases
    .filter((r) => /^v?\d+\.\d+\.\d+$/.test(r.tag))
    .filter((r) => isComplete(r))
    // newer than the latest authored entry ⇒ not already in CHANGELOG.md
    .filter((r) => compareVersions(r.tag, latestParsed) > 0)
    .map((r) => {
      const version = r.tag.replace(/^v/, "")
      const body = r.body.trim()
      return {
        id: slugify(r.tag),
        title: r.tag,
        version,
        date: monthYear(r.publishedAt),
        isWeekly: false,
        summary: "Latest release",
        bodyHtml: body
          ? renderMarkdownBlock(body)
          : `<p class="text-[14px] leading-[1.7] text-terminal-muted">Release published — full notes on <a href="${r.htmlUrl}" target="_blank" rel="noreferrer" class="text-terminal-accent underline underline-offset-2">GitHub ↗</a>.</p>`,
        empty: false,
      } satisfies ChangelogEntry
    })
} catch {
  releaseStubs = []
}

const entries = [...releaseStubs, ...parsed]
const latest = entries.find((e) => e.version) ?? entries[0] ?? null
const seoDescription =
  "nikcli changelog — release notes, new features, and fixes for every version, kept in sync with the source CHANGELOG on every release."
---

<Layout title="Changelog — nikcli" description={seoDescription}>
  <Navbar />
  <main id="main-content" tabindex="-1" class="flex-1 w-full bg-terminal-bg relative isolate outline-none">
    <!-- Hero -->
    <section class="page-section relative">
      <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[240px] bg-terminal-accent/6 blur-[110px] rounded-full"></div>
      </div>
      <div class="page-shell flex flex-col items-center text-center">
        <div class="inline-flex items-center gap-2 mb-5">
          <div class="h-px w-6 bg-terminal-accent" aria-hidden="true"></div>
          <span class="font-mono text-eyebrow uppercase tracking-[0.2em] text-terminal-accent">Changelog</span>
          <div class="h-px w-6 bg-terminal-accent" aria-hidden="true"></div>
        </div>
        <h1 class="font-display text-[clamp(2rem,5vw,3.5rem)] font-extrabold leading-[1.04] tracking-[-0.035em] text-terminal-text mb-4">
          What's new in<br /><span class="text-terminal-muted font-semibold">nikcli.</span>
        </h1>
        <p class="max-w-xl text-[clamp(0.9rem,1.5vw,1.05rem)] text-terminal-muted leading-relaxed mb-7">
          Every release, documented. New features, fixes, and improvements — synced from the
          source changelog on each version.
        </p>
        {latest?.version && (
          <a
            href={`/download?version=${latest.version}`}
            class="inline-flex items-center gap-2 rounded-[var(--radius-md)] bg-terminal-accent px-4 py-2 text-[13px] font-bold text-terminal-bg transition-[transform,opacity] hover:opacity-90 hover:-translate-y-px active:scale-[0.97] shadow-[0_2px_12px_-2px_rgb(var(--terminal-accent)/0.5)]"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
            </svg>
            Download v{latest.version}
          </a>
        )}
      </div>
    </section>

    <div class="page-shell pb-20">
      {entries.length === 0 ? (
        <p class="text-center text-[14px] text-terminal-muted">No changelog entries available.</p>
      ) : (
        <div class="mx-auto max-w-3xl">
          <ol class="relative border-l border-terminal-border/60 ml-2 sm:ml-3">
            {entries.map((entry) => (
              <li id={entry.id} class="relative pl-7 sm:pl-9 pb-12 last:pb-0 scroll-mt-24">
                <!-- timeline dot -->
                <span
                  class={[
                    "absolute -left-[7px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-terminal-bg",
                    entry.version === latest?.version ? "bg-terminal-accent" : "bg-terminal-border",
                  ].join(" ")}
                  aria-hidden="true"
                ></span>

                <div class="rounded-[var(--radius-card)] border border-terminal-border/60 bg-terminal-panel p-6 sm:p-7 shadow-soft">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-4">
                    <a href={`#${entry.id}`} class="group inline-flex items-center gap-2">
                      <h2 class="font-display text-[1.3rem] font-bold tracking-tight text-terminal-text">{entry.title}</h2>
                      <span class="text-terminal-muted/40 opacity-0 group-hover:opacity-100 transition-opacity">#</span>
                    </a>
                    {entry.version === latest?.version && (
                      <span class="inline-flex items-center gap-1.5 rounded-full border border-terminal-accent/25 bg-terminal-accent/10 px-2.5 py-0.5 font-mono text-[10.5px] font-bold uppercase tracking-[0.1em] text-terminal-accent">
                        Latest
                      </span>
                    )}
                    {entry.date && (
                      <span class="font-mono text-[12px] text-terminal-muted/70">{entry.date}</span>
                    )}
                    {entry.version && (
                      <a
                        href={`/download?version=${entry.version}`}
                        class="ml-auto inline-flex items-center gap-1.5 text-[12.5px] font-medium text-terminal-muted hover:text-terminal-accent transition-colors"
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
                        </svg>
                        Download
                      </a>
                    )}
                  </div>

                  {entry.empty ? (
                    <p class="text-[13.5px] italic text-terminal-muted/70">No notable changes.</p>
                  ) : (
                    <div class="changelog-body" set:html={entry.bodyHtml} />
                  )}
                </div>
              </li>
            ))}
          </ol>

          <div class="mt-10 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-terminal-border/50 pt-8 text-[13px] text-terminal-muted">
            <span>Full history and release artifacts</span>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
              <a href="/download" class="font-medium hover:text-terminal-text transition-colors">Downloads →</a>
              <a href="https://github.com/nikomatt69/nikcli/releases" target="_blank" rel="noreferrer" class="font-medium hover:text-terminal-text transition-colors">GitHub Releases ↗</a>
            </div>
          </div>
        </div>
      )}
    </div>
  </main>
</Layout>

<style>
  .changelog-body :global(h3:first-child) {
    margin-top: 0;
  }
</style>
