                <div class="viz-tooltip" data-tooltip hidden role="status" aria-live="polite"></div>
              </div>
              <p class="mt-3 text-[13px] text-terminal-muted">
                Hover a day for its breakdown, or focus the chart and use the arrow keys.
              </p>
            </div>
          </section>

          {/* ── Daily completions ────────────────────────────────────────── */}
          <section class="page-shell pb-14" aria-labelledby="requests-heading">
            <div class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8">
