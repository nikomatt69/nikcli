                                {changeDirection(model.change) === "flat"
                                  ? "flat"
                                  : signedPercent.format(model.change)}
                              </span>
                            </span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          {/* ── Cost per completion & blended price ──────────────────────── */}
          <div class="page-shell grid items-start gap-6 pb-14 lg:grid-cols-2">
            <section
              class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8"
              aria-labelledby="cost-heading"
              id="cost"
            >
              <h2 id="cost-heading" class="font-display text-panel-title text-terminal-text">
                Cost per completion
              </h2>
              <p class="mt-2 text-body-sm text-terminal-muted">
                What one call actually billed, most expensive first —
                {" "}{money(gateway.totals.costPerRequest, 4)} across all models. A call's cost is its price per token
                times how many it used, so the tokens each model spends per call is shown beside it.
              </p>
              <ul class="mt-6 space-y-3.5">
                {costLeaders.map((model) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3">
                      <span class="truncate font-mono text-[13px] text-terminal-text">{model.model}</span>
                      <span class="shrink-0 tabular-nums text-body-sm text-terminal-text">
                        {money(model.costPerRequest, 4)}
                      </span>
                    </div>
                    <span class="viz-track mt-1.5 block h-2 overflow-hidden rounded-full" aria-hidden="true">
                      <span
                        class="block h-full rounded-full"
                        style={`width:${maxCostPerRequest > 0 ? Math.max((model.costPerRequest / maxCostPerRequest) * 100, 1) : 0}%;background:var(--series-1)`}
                      />
                    </span>
                    <p class="mt-1 text-[13px] tabular-nums text-terminal-muted">
                      {compact.format(model.tokensPerRequest)} tokens per call
                    </p>
                  </li>
                ))}
              </ul>
            </section>

            <section
              class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8"
              aria-labelledby="price-heading"
              id="price"
            >
              <h2 id="price-heading" class="font-display text-panel-title text-terminal-text">
                Blended price per 1M tokens
              </h2>
              <p class="mt-2 text-body-sm text-terminal-muted">
                Billed dollars divided by tokens served, dearest first, so cached reads and the input/output mix are
                already in the number. Not a rate card — what the traffic came to.
              </p>
              <ul class="mt-6 space-y-3.5">
                {priceLeaders.map((model) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3">
                      <span class="truncate font-mono text-[13px] text-terminal-text">{model.model}</span>
                      <span class="shrink-0 tabular-nums text-body-sm text-terminal-text">
                        {money(model.pricePerMillion, 2)}
                      </span>
                    </div>
                    <span class="viz-track mt-1.5 block h-2 overflow-hidden rounded-full" aria-hidden="true">
                      <span
                        class="block h-full rounded-full"
                        style={`width:${maxPricePerMillion > 0 ? Math.max((model.pricePerMillion / maxPricePerMillion) * 100, 1) : 0}%;background:var(--series-1)`}
                      />
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          </div>

          {/* ── Cache & providers ────────────────────────────────────────── */}
          <div class="page-shell grid items-start gap-6 pb-14 lg:grid-cols-2">
            <section
              class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8"
              aria-labelledby="cache-heading"
              id="cache"
            >
              <h2 id="cache-heading" class="font-display text-panel-title text-terminal-text">
                Cache hit ratio
              </h2>
              <p class="mt-2 text-body-sm text-terminal-muted">
                Share of input tokens read from cache rather than re-sent. Taken over input only — an output token is
                generated every time, so it can never be cached. Across every model:
                {" "}{compact.format(gateway.totals.cacheReadTokens)} cached against
                {" "}{compact.format(gateway.totals.inputTokens)} sent.
              </p>
              {cacheLeaders.length === 0 ? (
                <p class="mt-6 text-body-sm text-terminal-muted">No model in this window sent input tokens.</p>
              ) : (
                <ul class="mt-6 space-y-3.5">
                  {cacheLeaders.map((model) => (
                    <li>
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="truncate font-mono text-[13px] text-terminal-text">{model.model}</span>
                        <span class="shrink-0 tabular-nums text-body-sm text-terminal-text">
                          {percent.format(model.cacheRatio!)}
                        </span>
                      </div>
                      <span class="viz-track mt-1.5 block h-2 overflow-hidden rounded-full" aria-hidden="true">
                        <span
                          class="block h-full rounded-full"
                          style={`width:${Math.max(model.cacheRatio! * 100, 1)}%;background:var(--series-1)`}
                        />
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </section>

            <section
              class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8"
              aria-labelledby="providers-heading"
              id="providers"
            >
              <h2 id="providers-heading" class="font-display text-panel-title text-terminal-text">
                Provider share
              </h2>
              <p class="mt-2 text-body-sm text-terminal-muted">
                Which upstream served the tokens. A model reached by more than one provider is counted under each.
              </p>
              <ul class="mt-6 space-y-3.5">
                {gateway.providers.map((provider) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3">
                      <span class="truncate text-body-sm text-terminal-text">{provider.provider}</span>
                      <span class="shrink-0 tabular-nums text-body-sm text-terminal-text">
                        {percent.format(provider.share)}
                      </span>
                    </div>
                    <span class="viz-track mt-1.5 block h-2 overflow-hidden rounded-full" aria-hidden="true">
                      <span
                        class="block h-full rounded-full"
                        style={`width:${maxProviderTokens > 0 ? Math.max((provider.tokens / maxProviderTokens) * 100, 1) : 0}%;background:var(--series-1)`}
                      />
                    </span>
                    <p class="mt-1 text-[13px] tabular-nums text-terminal-muted">
                      {compact.format(provider.tokens)} tokens · {whole.format(provider.requests)} completions
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          </div>
        </>
      )
    }

    {/* ── Adoption ───────────────────────────────────────────────────────── */}
    {
      downloads.length > 1 && (
        <section class="page-shell pb-14" aria-labelledby="adoption-heading" id="adoption">
          <div class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <div>
                <h2 id="adoption-heading" class="font-display text-panel-title text-terminal-text">
                  Adoption
                </h2>
                <p class="mt-2 max-w-2xl text-body-sm text-terminal-muted">
                  Cumulative installs since {shortDay(firstDownload.date)}, recorded by the release workflow in
                  STATS.md. Plotted on a real time axis — the log is written on release days, not daily.
                </p>
              </div>
              <p class="text-body-sm text-terminal-muted">
                <span class="font-semibold text-terminal-text">{whole.format(lastDownload.total)}</span> total
              </p>
            </div>

            <div class="mt-6 overflow-x-auto">
            <svg
              viewBox={`0 0 ${CHART_W} ${PAD.top + DOWNLOADS_H + PAD.bottom}`}
              class="w-full min-w-[520px]"
              role="img"
              aria-label={`Cumulative installs, reaching ${whole.format(lastDownload.total)} by ${shortDay(lastDownload.date)}. Every recorded figure is in the table below.`}
            >
              {downloadTicks.map((tick) => (
                <>
                  <line
                    x1={PAD.left}
                    x2={CHART_W - PAD.right}
                    y1={downloadY(tick)}
                    y2={downloadY(tick)}
                    class="viz-grid"
                  />
                  <text x={PAD.left - 10} y={downloadY(tick) + 4} text-anchor="end" class="viz-tick">
                    {compact.format(tick)}
                  </text>
                </>
              ))}
              <polyline
                points={downloadLine}
                fill="none"
                stroke="var(--series-1)"
                stroke-width="2"
                stroke-linejoin="round"
                stroke-linecap="round"
              />
              {/* A dot at every reading, so the line reads as 24 release-day
                  measurements joined up rather than a daily series. */}
              {downloads.map((point) => (
                <circle
                  cx={downloadX(point.date)}
                  cy={downloadY(point.total)}
                  r="2.5"
                  fill="var(--series-1)"
                  class="viz-endpoint"
                />
              ))}
              <circle
                cx={downloadX(lastDownload.date)}
                cy={downloadY(lastDownload.total)}
                r="4.5"
                fill="var(--series-1)"
                class="viz-endpoint"
              />
              <text
                x={downloadX(lastDownload.date) - 12}
                y={downloadY(lastDownload.total) - 12}
                text-anchor="end"
                class="viz-label"
              >
                {compact.format(lastDownload.total)}
              </text>
              {downloadAxisDates.map((point) => (
                <text
                  x={downloadX(point.date)}
                  y={PAD.top + DOWNLOADS_H + 20}
                  text-anchor={point.anchor}
                  class="viz-tick"
                >
                  {shortDay(point.date)}
                </text>
              ))}
            </svg>
            </div>

            <p class="mt-8 text-body-sm text-terminal-muted">
              The {Math.min(DOWNLOAD_TABLE_ROWS, downloads.length)} most recent of {downloads.length} readings, split by
              source. Readings are taken on release days, so the dates are not consecutive.
            </p>
            <div class="mt-3 overflow-x-auto">
              <table class="w-full min-w-[420px] border-collapse text-body-sm">
                <caption class="sr-only">Recorded download totals, newest first</caption>
                <thead>
                  <tr class="border-b border-terminal-border/60 text-left">
                    <th scope="col" class="py-3 pr-3 text-eyebrow uppercase font-semibold text-terminal-muted">Recorded</th>
                    <th scope="col" class="py-3 pr-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">npm</th>
                    <th scope="col" class="py-3 pr-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">GitHub</th>
                    <th scope="col" class="py-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">Total</th>
                  </tr>
                </thead>
                <tbody>
                  {[...downloads].reverse().slice(0, DOWNLOAD_TABLE_ROWS).map((point) => (
                    <tr class="border-b border-terminal-border/40 last:border-0">
                      <td class="py-2.5 pr-3 text-terminal-muted">{shortDay(point.date)}</td>
                      <td class="py-2.5 pr-3 text-right tabular-nums text-terminal-text">{whole.format(point.npm)}</td>
                      <td class="py-2.5 pr-3 text-right tabular-nums text-terminal-text">{whole.format(point.github)}</td>
                      <td class="py-2.5 text-right tabular-nums text-terminal-text">{whole.format(point.total)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>
      )
    }

    {/* ── Methodology ────────────────────────────────────────────────────── */}
    <section class="page-shell pb-20" aria-labelledby="method-heading">
      <div class="rounded-card border border-terminal-border/60 bg-terminal-panel/60 p-6 sm:p-8">
        <h2 id="method-heading" class="font-display text-card-title text-terminal-text">How this is measured</h2>
        <dl class="mt-5 grid gap-5 sm:grid-cols-2">
          <div>
            <dt class="text-body-sm font-semibold text-terminal-text">Sources</dt>
            <dd class="mt-1 text-body-sm text-terminal-muted">
              Gateway figures are one row per served completion, written to the same table billing reads. Community
              figures are what installs opted in to report about the models they run themselves. Adoption comes from
              STATS.md in the repository.
            </dd>
          </div>
          <div>
            <dt class="text-body-sm font-semibold text-terminal-text">Time windows</dt>
            <dd class="mt-1 text-body-sm text-terminal-muted">
              Headline figures and the leaderboard cover {WINDOW_DAYS} days; the charts cover {SERIES_DAYS}. Change
              compares consecutive {WINDOW_DAYS}-day windows.
            </dd>
          </div>
          <div>
            <dt class="text-body-sm font-semibold text-terminal-text">Privacy</dt>
            <dd class="mt-1 text-body-sm text-terminal-muted">
              Only aggregates are queried. No account, key or request identifier is read, so nothing here can be traced
              to a user. Prompt content is never stored in the first place. Community reporting is off unless you turn
              it on, and the identifier an install sends is random, local, and never published.
            </dd>
          </div>
          <div>
            <dt class="text-body-sm font-semibold text-terminal-text">Freshness</dt>
            <dd class="mt-1 text-body-sm text-terminal-muted">
              Rendered {updatedAt} UTC and cached at the edge for 15 minutes.
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </main>

  {gateway !== null && <script is:inline type="application/json" data-token-series set:html={tooltipJson} />}
</Layout>

<style>
  /* Validated categorical palette (dataviz slots 1–8) stepped for each mode.
     Light surface #ffffff and dark surface #0d0d0f are the panel colours these
     charts actually render on; both modes pass the adjacent CVD and
     normal-vision gates. The light steps sit under 3:1 on white, so the
     leaderboard table ships the same values as text. */
  .viz {
    --series-1: #2a78d6;
    --series-2: #eb6834;
    --series-3: #1baf7a;
    --series-4: #eda100;
    --series-5: #e87ba4;
    --series-6: #008300;
    --series-7: #4a3aa7;
    --series-8: #e34948;
    --series-other: #9c9a92;
    --viz-grid: rgb(var(--terminal-border));
    --viz-surface: rgb(var(--terminal-panel));

    /* Sequential blue ramp for the activity grid — one hue, light to dark, with
       a neutral empty step so "no traffic" never reads as "a little traffic". */
    --heat-0: rgb(var(--terminal-border) / 0.5);
    --heat-1: #cde2fb;
    --heat-2: #9ec5f4;
    --heat-3: #5598e7;
    --heat-4: #2a78d6;
    --heat-5: #184f95;
  }

  :root[data-theme="dark"] .viz {
    --series-1: #3987e5;
    --series-2: #d95926;
    --series-3: #199e70;
    --series-4: #c98500;
    --series-5: #d55181;
    --series-6: #008300;
    --series-7: #9085e9;
    --series-8: #e66767;
    --series-other: #6e6b64;
    /* Dark steps run the ramp the other way: the deepest blue would vanish into
       the panel, so the busiest day is the lightest step. */
    --heat-0: rgb(var(--terminal-border) / 0.8);
    --heat-1: #184f95;
    --heat-2: #256abf;
    --heat-3: #3987e5;
    --heat-4: #6da7ec;
    --heat-5: #9ec5f4;
  }

  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) .viz {
      --series-1: #3987e5;
      --series-2: #d95926;
      --series-3: #199e70;
      --series-4: #c98500;
      --series-5: #d55181;
      --series-6: #008300;
      --series-7: #9085e9;
      --series-8: #e66767;
      --series-other: #6e6b64;
    /* Dark steps run the ramp the other way: the deepest blue would vanish into
       the panel, so the busiest day is the lightest step. */
    --heat-0: rgb(var(--terminal-border) / 0.8);
    --heat-1: #184f95;
    --heat-2: #256abf;
    --heat-3: #3987e5;
    --heat-4: #6da7ec;
    --heat-5: #9ec5f4;
    }
  }

  .viz-grid {
    stroke: var(--viz-grid);
    stroke-width: 1;
  }

  .viz-tick {
    fill: rgb(var(--terminal-muted));
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .viz-label {
    fill: rgb(var(--terminal-text));
    font-family: "Figtree", system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
  }

  .viz-track {
    background: rgb(var(--terminal-border) / 0.55);
  }

  .viz-endpoint {
    stroke: var(--viz-surface);
    stroke-width: 2;
  }

  .viz-cursor {
    stroke: rgb(var(--terminal-text) / 0.35);
    stroke-width: 1.5;
    opacity: 0;
  }

  .viz-plot svg:focus-visible {
    outline: 2px solid rgb(var(--terminal-accent));
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .viz-tooltip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    min-width: 9.5rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid rgb(var(--terminal-border));
    border-radius: var(--radius-md);
    background: rgb(var(--terminal-panel));
    box-shadow: var(--shadow-strong);
    pointer-events: none;
    transform: translateX(-50%);
  }

  .viz-tooltip[hidden] {
    display: none;
  }
</style>

<script>
  const initTokenChart = () => {
    const svg = document.querySelector<SVGSVGElement>("[data-token-chart]")
    const host = svg?.closest<HTMLElement>("[data-tooltip-host]")
    const tooltip = host?.querySelector<HTMLElement>("[data-tooltip]")
    const cursor = svg?.querySelector<SVGRectElement>("[data-cursor]")
    const payload = document.querySelector<HTMLScriptElement>("[data-token-series]")
    if (!svg || !host || !tooltip || !cursor || !payload) return

    type Row = { model: string; value: string; color: string }
    type Column = { day: string; total: string; requests: string; rows: Row[] }
    let columns: Column[] = []
    try {
      columns = JSON.parse(payload.textContent ?? "[]")
    } catch {
      return
    }
    if (columns.length === 0) return

    const hitAreas = [...svg.querySelectorAll<SVGRectElement>("[data-column]")]
    let active = -1

    // Series names come from the database, so every one of them is inserted as
    // text, never as markup.
    const render = (index: number) => {
      const column = columns[index]
      const target = hitAreas[index]
      if (!column || !target) return
      active = index
      tooltip.replaceChildren()

      const day = document.createElement("p")
      day.className = "text-[11px] uppercase tracking-wider text-terminal-muted"
      day.textContent = column.day
      tooltip.append(day)

      const total = document.createElement("p")
      total.className = "mt-0.5 text-sm font-semibold text-terminal-text"
      total.textContent = `${column.total} tokens`
      tooltip.append(total)

      const meta = document.createElement("p")
      meta.className = "text-[12px] text-terminal-muted"
      meta.textContent = `${column.requests} completions`
      tooltip.append(meta)

      if (column.rows.length > 0) {
        const list = document.createElement("ul")
        list.className = "mt-2 space-y-1 border-t border-terminal-border/60 pt-2"
        for (const row of column.rows) {
          const item = document.createElement("li")
          item.className = "flex items-center justify-between gap-3 text-[12px]"
          const name = document.createElement("span")
          name.className = "flex min-w-0 items-center gap-1.5 text-terminal-muted"
          const key = document.createElement("span")
          key.className = "h-0.5 w-3 shrink-0 rounded-full"
          key.style.background = row.color
          const label = document.createElement("span")
          label.className = "truncate font-mono"
          label.textContent = row.model
          name.append(key, label)
          const value = document.createElement("span")
          value.className = "shrink-0 font-semibold tabular-nums text-terminal-text"
          value.textContent = row.value
          item.append(name, value)
          list.append(item)
        }
        tooltip.append(list)
      }

      const area = target.getBoundingClientRect()
      const bounds = host.getBoundingClientRect()
      tooltip.hidden = false
      // Anchored inside the plot and kept clear of both edges: the card scrolls
      // horizontally on small screens, so a tooltip hanging past its bounds
      // would be clipped rather than merely overhang.
      tooltip.style.left = "0px"
      tooltip.style.top = "0px"
      const width = tooltip.getBoundingClientRect().width
      const centre = area.left - bounds.left + host.scrollLeft + area.width / 2
      const limit = Math.max(host.scrollWidth - width / 2 - 8, width / 2 + 8)
      tooltip.style.left = `${Math.min(Math.max(centre, width / 2 + 8), limit)}px`
      tooltip.style.top = `${area.top - bounds.top + 8}px`

      cursor.setAttribute("x", target.getAttribute("x") ?? "0")
      cursor.setAttribute("width", target.getAttribute("width") ?? "0")
      cursor.style.opacity = "1"
    }

    const clear = () => {
      active = -1
      tooltip.hidden = true
      cursor.style.opacity = "0"
    }

    hitAreas.forEach((area, index) => {
      area.addEventListener("pointerenter", () => render(index))
    })
    svg.addEventListener("pointerleave", clear)
    svg.addEventListener("blur", clear)
    svg.addEventListener("focus", () => render(active >= 0 ? active : columns.length - 1))
    svg.addEventListener("keydown", (event) => {
      const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0
      if (step === 0) {
        if (event.key === "Escape") clear()
        return
      }
      event.preventDefault()
      render(Math.min(Math.max((active < 0 ? columns.length - 1 : active) + step, 0), columns.length - 1))
    })
  }

  initTokenChart()
  document.addEventListener("astro:page-load", initTokenChart)
</script>
