                            />
                          </span>
                          <span class="tabular-nums text-terminal-muted">{percent.format(model.share)}</span>
                        </span>
                      </td>
                      <td class="py-3 pr-3 text-right tabular-nums text-terminal-muted">
                        {whole.format(model.installs)}
                      </td>
                      <td class="py-3 text-right tabular-nums">
                        {model.change === null ? (
                          <span class="text-terminal-muted">new</span>
