                          <span class="inline-flex items-center gap-1">
                            <span aria-hidden="true" class={changeClass[changeDirection(model.change)]}>
                              {changeArrow[changeDirection(model.change)]}
                            </span>
                            <span class="text-terminal-text">
                              {changeDirection(model.change) === "flat" ? "flat" : signedPercent.format(model.change)}
                            </span>
                          </span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p class="mt-6 text-[13px] text-terminal-muted">
              Reporting is off unless you turn it on. With <code class="rounded-sm bg-terminal-code px-1.5 py-0.5">analytics.share</code>
              {" "}set, nikcli sends one row per day, provider and model — message count, token count and cost. Never
              prompts, paths, repositories or session titles.
            </p>
          </div>
        </section>
      )
    }

    {
      gateway === null ? (
        <section class="page-shell pb-16">
          <div class="rounded-card border border-terminal-border/60 bg-terminal-panel p-8">
            <h2 class="font-display text-card-title text-terminal-text">No gateway usage published yet</h2>
            <p class="mt-3 max-w-2xl text-body-sm text-terminal-muted">
              The inference gateway has recorded no completions in the last {WINDOW_DAYS} days, or this deployment
              cannot reach the usage feed. Rather than draw an empty axis, this page shows the sections it can
              measure. Adoption, below, comes from the release log and is always current.
            </p>
          </div>
        </section>
      ) : (
        <>
          {/* ── Headline ─────────────────────────────────────────────────── */}
          <section class="page-shell pb-14" aria-labelledby="overview-heading">
            <h2 id="overview-heading" class="sr-only">
              Last {WINDOW_DAYS} days at a glance
            </h2>
            <div class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8">
              <p class="text-eyebrow uppercase text-terminal-muted">
                Through the nikcli gateway · last {WINDOW_DAYS} days
              </p>
              <p class="mt-2 font-sans text-[clamp(3rem,7vw,4.5rem)] font-bold leading-none tracking-tight text-terminal-text">
                {compact.format(gateway.totals.tokens)}
              </p>
              {gateway.totals.change !== null && (
                <p class="mt-3 flex items-center gap-1.5 text-body-sm">
                  <span aria-hidden="true" class={changeClass[changeDirection(gateway.totals.change)]}>
                    {changeArrow[changeDirection(gateway.totals.change)]}
                  </span>
                  <span class="font-semibold text-terminal-text">
                    {changeDirection(gateway.totals.change) === "flat"
                      ? "Flat"
                      : signedPercent.format(gateway.totals.change)}
                  </span>
                  <span class="text-terminal-muted">vs the {WINDOW_DAYS} days before</span>
                </p>
              )}

              {/* Three across, two rows: six tiles in one row squeezes the
                  longer labels onto a second line and knocks the values out of
                  alignment with each other. */}
              <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-7 border-t border-terminal-border/50 pt-7 sm:grid-cols-3">
                <div>
                  <dt class="text-eyebrow uppercase text-terminal-muted">Completions</dt>
                  <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">
                    {compact.format(gateway.totals.requests)}
                  </dd>
                </div>
                <div>
                  <dt class="text-eyebrow uppercase text-terminal-muted">Models routed</dt>
                  <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">{gateway.totals.models}</dd>
                </div>
                <div>
                  <dt class="text-eyebrow uppercase text-terminal-muted">Blended price / 1M</dt>
                  <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">
                    {money(gateway.totals.pricePerMillion, 2)}
                  </dd>
                </div>
                <div>
                  <dt class="text-eyebrow uppercase text-terminal-muted">Billed</dt>
                  <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">
                    {money(gateway.totals.costUsd, 0)}
                  </dd>
                </div>
                <div>
                  <dt class="text-eyebrow uppercase text-terminal-muted">Providers</dt>
                  <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">
                    {gateway.totals.providers}
                  </dd>
                </div>
                <div>
                  <dt class="text-eyebrow uppercase text-terminal-muted">Input read from cache</dt>
                  <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">
                    {gateway.totals.cacheRatio === null ? "No input tokens" : percent.format(gateway.totals.cacheRatio)}
                  </dd>
                </div>
              </dl>
            </div>
          </section>

          {/* ── Tokens over time ─────────────────────────────────────────── */}
          <section class="page-shell pb-14" aria-labelledby="models-heading" id="models">
            <div class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8">
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div>
                  <h2 id="models-heading" class="font-display text-panel-title text-terminal-text">
                    Tokens by model
                  </h2>
                  <p class="mt-2 text-body-sm text-terminal-muted">
                    Daily prompt plus completion tokens over the last {SERIES_DAYS} days, stacked by the model the
                    router resolved to.
                  </p>
                </div>
                {peakDay && peakDay.tokens > 0 && (
                  <p class="text-body-sm text-terminal-muted">
                    Peak <span class="font-semibold text-terminal-text">{compact.format(peakDay.tokens)}</span> on{" "}
                    {shortDay(peakDay.day)}
                  </p>
                )}
              </div>

              <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2" aria-label="Models in this chart">
                {seriesModels.map((model) => (
                  <li class="flex items-center gap-2 text-[13px] text-terminal-muted">
                    <span
                      class="h-2.5 w-2.5 shrink-0 rounded-[2px]"
                      style={`background:${bandColor(model)}`}
                      aria-hidden="true"
                    />
                    <span class="font-mono">{model}</span>
                  </li>
                ))}
              </ul>

              {/* Below ~700px the 61 columns would scale the 11px axis text down
                  to something unreadable, so the chart keeps its size and the
                  card scrolls instead. */}
              <div class="viz-plot relative mt-5 overflow-x-auto" data-tooltip-host>
                <svg
                  viewBox={`0 0 ${CHART_W} ${PAD.top + TOKENS_H + PAD.bottom}`}
                  class="w-full min-w-[700px]"
                  role="img"
                  aria-label={`Daily tokens by model over the last ${SERIES_DAYS} days. Total ${compact.format(gateway.totals.tokens)} tokens. Per-day values are listed in the leaderboard table below.`}
                  tabindex="0"
                  data-token-chart
                >
                  {tokenTicks.map((tick) => (
                    <>
                      <line
                        x1={PAD.left}
                        x2={CHART_W - PAD.right}
                        y1={PAD.top + TOKENS_H - (tick / tokenMax) * TOKENS_H}
                        y2={PAD.top + TOKENS_H - (tick / tokenMax) * TOKENS_H}
                        class="viz-grid"
                      />
                      <text
                        x={PAD.left - 10}
                        y={PAD.top + TOKENS_H - (tick / tokenMax) * TOKENS_H + 4}
                        text-anchor="end"
                        class="viz-tick"
                      >
                        {compact.format(tick)}
                      </text>
                    </>
                  ))}

                  {tokenColumns.map((column) =>
                    column.segments.map((segment) =>
                      segment.rounded ? (
                        <path d={topRoundedBar(segment.x, segment.y, barW, segment.height)} fill={bandColor(segment.model)} />
                      ) : (
                        <rect
                          x={segment.x}
                          y={segment.y}
                          width={barW}
                          height={segment.height}
                          fill={bandColor(segment.model)}
                        />
