                      style={`background:var(--heat-${step})`}
                      aria-hidden="true"
                    />
                  ))}
                  <span>Busier</span>
                </div>
              </div>
            </section>
          )}

          {/* ── Leaderboard ──────────────────────────────────────────────── */}
          <section class="page-shell pb-14" aria-labelledby="leaderboard-heading" id="leaderboard">
            <div class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8">
              <h2 id="leaderboard-heading" class="font-display text-panel-title text-terminal-text">
                Model leaderboard
              </h2>
              <p class="mt-2 max-w-2xl text-body-sm text-terminal-muted">
                Ranked by tokens over the last {WINDOW_DAYS} days. Change compares against the {WINDOW_DAYS} days before
                that; a model with no traffic then shows no change instead of an infinite one.
                {gateway.models.length > LEADERBOARD_ROWS && (
                  <> Showing the top {LEADERBOARD_ROWS} of {gateway.models.length} models routed.</>
                )}
              </p>
              {/* Seven columns will not fit a phone, and a sideways-scrolling
                  table hides its own columns with no affordance — so on small
                  screens each model becomes a card carrying the same values. */}
              <ul class="mt-6 space-y-3 md:hidden">
                {leaderboard.map((model, index) => (
                  <li class="rounded-md border border-terminal-border/60 p-4">
                    <div class="flex items-center gap-2.5">
                      <span class="tabular-nums text-body-sm text-terminal-muted">{index + 1}</span>
                      {colorOf(model.model) && (
                        <span
