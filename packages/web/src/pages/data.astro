                one call to <code class="rounded-sm bg-terminal-code px-1.5 py-0.5 text-[0.85em]">/v1/chat/completions</code>.
              </p>
              <div class="mt-5 overflow-x-auto">
              <svg
                viewBox={`0 0 ${CHART_W} ${PAD.top + REQUESTS_H + PAD.bottom}`}
                class="w-full min-w-[700px]"
                role="img"
                aria-label={`Completions per day over the last ${SERIES_DAYS} days, ${whole.format(gateway.totals.requests)} in total.`}
              >
                {requestTicks.map((tick) => (
                  <>
                    <line
                      x1={PAD.left}
                      x2={CHART_W - PAD.right}
                      y1={PAD.top + REQUESTS_H - (tick / requestMax) * REQUESTS_H}
                      y2={PAD.top + REQUESTS_H - (tick / requestMax) * REQUESTS_H}
                      class="viz-grid"
                    />
                    <text
                      x={PAD.left - 10}
                      y={PAD.top + REQUESTS_H - (tick / requestMax) * REQUESTS_H + 4}
                      text-anchor="end"
                      class="viz-tick"
                    >
                      {compact.format(tick)}
                    </text>
                  </>
                ))}
                {requestColumns.map(
                  (column) =>
                    column.height > 0 && (
                      <path d={topRoundedBar(column.x, column.y, barW, column.height)} fill="var(--series-1)" />
                    ),
                )}
                {axisDays.map((point) => (
                  <text
                    x={PAD.left + point.index * slot + slot / 2}
                    y={PAD.top + REQUESTS_H + 20}
                    text-anchor="middle"
                    class="viz-tick"
                  >
                    {shortDay(point.day)}
                  </text>
                ))}
              </svg>
              </div>
            </div>
          </section>

          {/* ── Activity ─────────────────────────────────────────────────── */}
          {grid && grid.weeks > 0 && (
            <section class="page-shell pb-14" aria-labelledby="activity-heading" id="activity">
              <div class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8">
                <h2 id="activity-heading" class="font-display text-panel-title text-terminal-text">
                  A year of traffic
                </h2>
                <p class="mt-2 max-w-2xl text-body-sm text-terminal-muted">
                  Tokens per day over the last {gateway.activityDays} days, one square per day. Shade is that day's
                  share of the busiest day.
                </p>

                <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
                  <div>
                    <dt class="text-eyebrow uppercase text-terminal-muted">Days with traffic</dt>
                    <dd class="mt-1 font-sans text-xl font-semibold text-terminal-text">
                      {whole.format(gateway.activityStats.activeDays)}
                    </dd>
                  </div>
                  <div>
                    <dt class="text-eyebrow uppercase text-terminal-muted">Longest streak</dt>
                    <dd class="mt-1 font-sans text-xl font-semibold text-terminal-text">
                      {whole.format(gateway.activityStats.longestStreak)} days
                    </dd>
                  </div>
                  <div>
                    <dt class="text-eyebrow uppercase text-terminal-muted">Busiest day</dt>
                    <dd class="mt-1 font-sans text-xl font-semibold text-terminal-text">
                      {compact.format(gateway.activityStats.maxDay)}
                    </dd>
                  </div>
                  <div>
                    <dt class="text-eyebrow uppercase text-terminal-muted">Tokens all year</dt>
                    <dd class="mt-1 font-sans text-xl font-semibold text-terminal-text">
                      {compact.format(gateway.activityStats.total)}
                    </dd>
                  </div>
                </dl>

                <div class="mt-6 overflow-x-auto">
                  <svg
                    viewBox={`0 0 ${GRID_GUTTER + grid.weeks * CELL_PITCH} ${GRID_HEADER + 7 * CELL_PITCH}`}
                    width={GRID_GUTTER + grid.weeks * CELL_PITCH}
                    height={GRID_HEADER + 7 * CELL_PITCH}
                    role="img"
                    aria-label={`Tokens per day over the last ${gateway.activityDays} days. ${whole.format(gateway.activityStats.activeDays)} days had traffic, the busiest ${compact.format(gateway.activityStats.maxDay)} tokens.`}
                  >
                    {grid.monthLabels.map((month) => (
                      <text x={GRID_GUTTER + month.col * CELL_PITCH} y={GRID_HEADER - 5} class="viz-tick">
