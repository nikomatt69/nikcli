                  )}

                  {axisDays.map((point) => (
                    <text
                      x={PAD.left + point.index * slot + slot / 2}
                      y={PAD.top + TOKENS_H + 20}
                      text-anchor="middle"
                      class="viz-tick"
                    >
                      {shortDay(point.day)}
                    </text>
                  ))}

                  {tokenColumns.map((_column, index) => (
                    <rect
                      x={PAD.left + index * slot}
                      y={PAD.top}
                      width={slot}
                      height={TOKENS_H}
                      fill="transparent"
                      data-column={index}
                    />
                  ))}
                  <rect
                    x={PAD.left}
                    y={PAD.top}
                    width={barW}
                    height={TOKENS_H}
                    fill="none"
                    class="viz-cursor"
                    data-cursor
                    aria-hidden="true"
                  />
