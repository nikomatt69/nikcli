---
import "../../styles/global.css"
import { RegisterForm } from "@/dashboard/components/RegisterForm"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register | nikcli</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-terminal-bg font-sans antialiased">
    <div class="flex min-h-screen">
      <div class="hidden w-1/2 lg:flex lg:flex-col lg:justify-between bg-terminal-panel p-12">
        <div class="flex items-center gap-3">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-2xl bg-terminal-accent text-2xl font-bold text-white"
          >
            N
          </div>
          <div>
            <div class="text-xl font-bold text-terminal-text">nikcli</div>
            <div class="text-sm text-terminal-muted">AI Development Agent</div>
          </div>
        </div>

        <div class="space-y-6">
          <h2 class="text-4xl font-bold leading-tight text-terminal-text">
            Start your AI-powered<br />development journey
          </h2>
          <p class="max-w-md text-lg text-terminal-muted">
            Create your account and unlock the full power of nikcli's AI agent capabilities.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-6 text-sm text-terminal-muted">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-terminal-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="font-medium text-terminal-text">Unlimited sessions</span>
            </div>
            <p class="pl-7">Create and manage as many sessions as you need</p>
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-terminal-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="font-medium text-terminal-text">Real-time sync</span>
            </div>
            <p class="pl-7">Access your work from any device</p>
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-terminal-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="font-medium text-terminal-text">Secure access</span>
            </div>
            <p class="pl-7">Your data is encrypted and protected</p>
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-terminal-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="font-medium text-terminal-text">Always free</span>
            </div>
            <p class="pl-7">No credit card required</p>
          </div>
        </div>
      </div>

      <div class="flex w-full items-center justify-center px-8 lg:w-1/2">
        <div class="w-full max-w-md space-y-8">
          <div class="lg:hidden flex items-center gap-3 mb-8">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl bg-terminal-accent text-lg font-bold text-white"
            >
              N
            </div>
            <div class="text-lg font-semibold text-terminal-text">nikcli</div>
          </div>

          <div>
            <h1 class="text-2xl font-bold text-terminal-text">Create account</h1>
            <p class="mt-2 text-terminal-muted">Get started with nikcli today</p>
          </div>

          <RegisterForm client:load />

          <p class="text-center text-sm text-terminal-muted">
            Already have an account?
            <a href="/dashboard/login" class="font-medium text-terminal-accent hover:underline">Sign in</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
