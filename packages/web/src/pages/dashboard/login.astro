---
import "../../styles/global.css"
import { LoginForm } from "@/dashboard/components/LoginForm"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | nikcli</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-terminal-bg font-sans antialiased">
    <div class="flex min-h-screen">
      <div class="hidden w-1/2 lg:flex lg:flex-col lg:justify-between bg-terminal-panel p-12">
        <div class="flex items-center gap-3">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-2xl bg-terminal-accent text-2xl font-bold text-white"
          >
            N
          </div>
          <div>
            <div class="text-xl font-bold text-terminal-text">nikcli</div>
            <div class="text-sm text-terminal-muted">AI Development Agent</div>
          </div>
        </div>

        <div class="space-y-6">
          <h2 class="text-4xl font-bold leading-tight text-terminal-text">
            Your AI-powered<br />development workspace
          </h2>
          <p class="max-w-md text-lg text-terminal-muted">
            Access your sessions, manage configurations, and monitor your AI agent from anywhere.
          </p>
        </div>

        <div class="flex gap-8 text-sm text-terminal-muted">
          <div>
            <div class="text-3xl font-bold text-terminal-accent">∞</div>
            <div>Sessions</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-terminal-accent">24/7</div>
            <div>Available</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-terminal-accent">100%</div>
            <div>Secure</div>
          </div>
        </div>
      </div>

      <div class="flex w-full items-center justify-center px-8 lg:w-1/2">
        <div class="w-full max-w-md space-y-8">
          <div class="lg:hidden flex items-center gap-3 mb-8">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl bg-terminal-accent text-lg font-bold text-white"
            >
              N
            </div>
            <div class="text-lg font-semibold text-terminal-text">nikcli</div>
          </div>

          <div>
            <h1 class="text-2xl font-bold text-terminal-text">Welcome back</h1>
            <p class="mt-2 text-terminal-muted">Sign in to access your dashboard</p>
          </div>

          <LoginForm client:load />

          <p class="text-center text-sm text-terminal-muted">
            Don't have an account?
            <a href="/dashboard/register" class="font-medium text-terminal-accent hover:underline">Create one</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
