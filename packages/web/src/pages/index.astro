---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import InstallBlock from '../components/InstallBlock.astro';

const seoDescription = "Nikcli - The ultimate terminal-native AI development agent. Open source, provider agnostic, and packed with LSP intelligence.";
---

<Layout title="nikcli - AI-Powered Development Agent" description={seoDescription}>
  <Navbar />
  <main id="main-content" tabindex="-1" class="flex-1 w-full bg-terminal-bg relative isolate outline-none">
    <div class="absolute inset-0 bg-[url('/noise.png')] opacity-[0.02] dark:opacity-[0.03] mix-blend-overlay pointer-events-none -z-20"></div>
    <Hero />
    <Features />
    
    <section class="page-section border-b border-terminal-border/60">
      <div class="page-shell">
        <div class="mx-auto max-w-3xl text-center">
          <div class="inline-flex items-center justify-center p-4 mb-8 rounded-2xl bg-surface-active text-terminal-accent shadow-inner ring-1 ring-terminal-border/50">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
          </div>
          <h2 class="mb-6 text-3xl font-extrabold tracking-tight text-terminal-text sm:text-4xl">Fork Notice</h2>
          <p class="text-base font-medium leading-relaxed text-terminal-muted sm:text-lg md:text-xl">
            Nikcli is an independent evolution of an upstream open-source project. 
            It has been heavily extended and meticulously maintained to fit this exact workflow, adding new capabilities while staying true to its terminal-first roots.
          </p>
      </div>
      </div>
    </section>

    <InstallBlock />
  </main>
  
  <footer class="border-t border-terminal-border/80 bg-terminal-panel py-10 text-center text-sm font-medium text-terminal-muted shadow-inner sm:py-12">
    <div class="page-shell flex flex-col items-center justify-between gap-6 md:flex-row">
      <div class="flex items-center gap-3">
        <div class="w-5 h-5 rounded-md bg-terminal-accent/10 flex items-center justify-center border border-terminal-accent/20">
          <svg viewBox="0 0 24 24" class="w-3 h-3 text-terminal-accent" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 17l6-6-6-6M12 19h8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <span>&copy; {new Date().getFullYear()} Nikcli. MIT License.</span>
      </div>
      <div class="flex gap-6">
         <a href="https://github.com/nikomatt69/nikcli" class="hover:text-terminal-text transition-colors">GitHub</a>
         <a href="/docs" class="hover:text-terminal-text transition-colors">Documentation</a>
      </div>
    </div>
  </footer>
</Layout>
