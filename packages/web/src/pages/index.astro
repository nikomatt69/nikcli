---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import InstallBlock from '../components/InstallBlock.astro';
---

<Layout title="nikcli - AI-Powered Development Agent">
  <Navbar />
  <main id="main-content" tabindex="-1">
    <Hero />
    <Features />
    <section class="section">
      <div class="container">
        <h2 class="section-title">Fork notice</h2>
        <p class="section-lead">
          Nikcli is based on an upstream open-source project, extended and maintained to fit this project’s workflow.
        </p>
      </div>
    </section>
    <InstallBlock />
  </main>
</Layout>
