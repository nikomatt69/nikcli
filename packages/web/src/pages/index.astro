---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import InstallBlock from '../components/InstallBlock.astro';

const seoDescription = "Nikcli — an open-source, provider-agnostic AI development agent with terminal-native control, LSP awareness, MCP integrations, and mobile-ready session orchestration.";
---

<Layout title="nikcli — AI-Powered Development Agent" description={seoDescription}>
  <Navbar />
  <main id="main-content" tabindex="-1" class="flex-1 w-full bg-terminal-bg relative isolate outline-none">
    <Hero />
    <Features />

    <!-- Fork Notice -->
    <section class="page-section border-t border-terminal-border/50">
      <div class="page-shell">
        <div class="max-w-2xl mx-auto">
          <div class="rounded-[var(--radius-card)] border border-terminal-border/60 bg-terminal-panel p-7 sm:p-8 shadow-soft">
            <div class="flex items-start gap-4">
              <div class="shrink-0 flex h-10 w-10 items-center justify-center rounded-xl border border-terminal-accent/25 bg-terminal-accent/10 text-terminal-accent mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h2 class="font-display text-[1.1rem] font-bold tracking-tight text-terminal-text mb-2">Nikcli is a fork of OpenCode</h2>
                <p class="text-[14.5px] font-normal leading-[1.7] text-terminal-muted">
                  Nikcli is an independent fork of
                  <a href="https://github.com/anomalyco/opencode" target="_blank" rel="noopener noreferrer" class="text-terminal-accent hover:underline">OpenCode</a>,
                  the open source coding agent — full credit for the original project goes to its
                  authors and contributors. This fork extends it for one specific workflow: session
                  orchestration, mobile hosting, LSP/MCP surfaces, and operational tooling, keeping
                  the terminal-first experience at the center. Nikcli is not affiliated with or
                  endorsed by the OpenCode project; report nikcli issues here, not upstream.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <InstallBlock />
  </main>

</Layout>
