{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    // Not loaded globally: Workers types redefine DOM names (`Element`,
    // `CacheStorage`, …) and would shadow them in every client script. The few
    // Workers types this site needs are imported by name in src/env.d.ts.
    "types": []
  }
}
