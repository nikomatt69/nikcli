---
import Dashboard from "../../layouts/Dashboard.astro"
import { getCurrentUser } from "../../lib/auth"
import { getEnv } from "../../lib/env"

const user = await getCurrentUser(Astro as any).catch(() => null)
if (!user) return Astro.redirect("/sign-in")
const env = getEnv(Astro as any)
const keysCount = await env.DB.prepare("SELECT COUNT(*) as c FROM api_keys WHERE user_id = ? AND revoked_at IS NULL")
  .bind(user.id)
  .first<{ c: number }>()
const usage = await env.DB.prepare(
  `SELECT COUNT(*) as calls,
          COALESCE(SUM(prompt_tokens + completion_tokens), 0) as tokens,
          COALESCE(SUM(billed_usd), 0) as billed_usd
   FROM usage_events WHERE user_id = ? AND created_at > unixepoch() - 30*86400`,
)
  .bind(user.id)
  .first<{ calls: number; tokens: number; billed_usd: number }>()

const curlExample = `curl https://inference.nikcli.store/v1/chat/completions \\
  -H "Authorization: Bearer $NIKCLI_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"model":"nikseek","messages":[{"role":"user","content":"Hello"}]}'`
---

<Dashboard active="overview">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-display font-bold text-terminal-text">Welcome, {user.name ?? user.email.split("@")[0]}</h1>
      <p class="mt-1 text-sm text-terminal-muted">Your nikcli inference account at a glance.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="rounded-[var(--radius-card)] border border-terminal-border bg-terminal-panel p-5 shadow-soft">
        <p class="text-[11px] font-medium uppercase tracking-wider text-terminal-muted">Plan</p>
        <p class="mt-2 text-3xl font-display font-bold text-terminal-text capitalize">{user.plan}</p>
      </div>
      <div class="rounded-[var(--radius-card)] border border-terminal-border bg-terminal-panel p-5 shadow-soft">
        <p class="text-[11px] font-medium uppercase tracking-wider text-terminal-muted">Active keys</p>
        <p class="mt-2 text-3xl font-display font-bold text-terminal-text">{keysCount?.c ?? 0}</p>
        <a href="/dashboard/keys" class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-terminal-accent hover:underline">
          Manage →
        </a>
      </div>
      <div class="rounded-[var(--radius-card)] border border-terminal-border bg-terminal-panel p-5 shadow-soft">
        <p class="text-[11px] font-medium uppercase tracking-wider text-terminal-muted">Last 30 days</p>
        <p class="mt-2 text-3xl font-display font-bold text-terminal-text">${(usage?.billed_usd ?? 0).toFixed(4)}</p>
        <p class="mt-1 text-xs text-terminal-muted">{usage?.calls ?? 0} calls · {(usage?.tokens ?? 0).toLocaleString()} tokens</p>
      </div>
    </div>

    <div class="rounded-[var(--radius-card)] border border-terminal-border bg-terminal-panel p-6 shadow-soft">
      <h2 class="font-display font-semibold text-terminal-text">Quick start</h2>
      <p class="mt-2 text-sm text-terminal-muted">Generate a key and drop the gateway URL into Cursor or the OpenAI SDK.</p>
      <div class="mt-4 rounded-[var(--radius-md)] border border-terminal-border bg-terminal-code p-4 overflow-x-auto">
        <code class="font-mono text-[13px] text-terminal-text whitespace-pre">{curlExample}</code>
      </div>
      <div class="mt-4 flex flex-wrap gap-4 text-sm">
        <a href="/docs/cursor" class="inline-flex items-center gap-1 font-medium text-terminal-accent hover:underline">
          Use it in Cursor →
        </a>
        <a href="/docs" class="inline-flex items-center gap-1 font-medium text-terminal-accent hover:underline">
          All docs →
        </a>
      </div>
    </div>
  </div>
</Dashboard>