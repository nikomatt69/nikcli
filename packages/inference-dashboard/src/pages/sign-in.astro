---
import Base from "../layouts/Base.astro"
import Nav from "../components/Nav.astro"
import SignInForm from "../components/SignInForm"
---

<Base title="Sign in · nikcli Inference">
  <Nav />
  <main id="main-content" class="mx-auto grid w-full max-w-6xl gap-6 px-4 py-8 sm:px-6 md:grid-cols-[1fr_400px] md:gap-8 md:py-20">
    <section class="flex flex-col justify-between rounded-[var(--radius-card)] border border-terminal-border/70 bg-terminal-panel/70 p-5 shadow-soft sm:p-8 md:min-h-[560px]">
      <div>
        <p class="app-kicker">Gateway console</p>
        <h1 class="mt-4 max-w-xl font-display text-[clamp(2.4rem,6vw,4.8rem)] font-extrabold leading-none text-terminal-text">
          Route smarter from one clean control plane.
        </h1>
        <p class="mt-5 max-w-lg text-base leading-7 text-terminal-muted">
          Access keys, usage, routing docs, and account controls without leaving the inference dashboard.
        </p>
      </div>

      <div class="mt-10 grid gap-3 sm:grid-cols-3">
        <div class="rounded-[var(--radius-md)] border border-terminal-border bg-terminal-bg/50 p-4">
          <p class="font-display text-2xl font-bold text-terminal-text">14+</p>
          <p class="mt-1 text-xs font-medium uppercase tracking-wider text-terminal-muted">Providers</p>
        </div>
        <div class="rounded-[var(--radius-md)] border border-terminal-border bg-terminal-bg/50 p-4">
          <p class="font-display text-2xl font-bold text-terminal-text">100K</p>
          <p class="mt-1 text-xs font-medium uppercase tracking-wider text-terminal-muted">Free tokens</p>
        </div>
        <div class="rounded-[var(--radius-md)] border border-terminal-border bg-terminal-bg/50 p-4">
          <p class="font-display text-2xl font-bold text-terminal-text">1 API</p>
          <p class="mt-1 text-xs font-medium uppercase tracking-wider text-terminal-muted">OpenAI shape</p>
        </div>
      </div>
    </section>

    <section class="app-panel app-panel-pad self-center">
      <p class="app-kicker">Welcome back</p>
      <h2 class="mt-3 font-display text-2xl font-bold text-terminal-text">Sign in</h2>
      <p class="mt-2 text-sm leading-6 text-terminal-muted">Continue to your nikcli inference account.</p>
      <div class="mt-7">
        <SignInForm client:load />
      </div>
      <p class="mt-6 text-center text-sm text-terminal-muted">
        No account? <a href="/sign-up" class="font-medium text-terminal-accent hover:underline">Get a key</a>
      </p>
    </section>
  </main>
</Base>
