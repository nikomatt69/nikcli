---
import Base from "./Base.astro"
import Nav from "../components/Nav.astro"
import { getCurrentUser } from "../lib/auth"

const user = await getCurrentUser(Astro as any).catch(() => null)
if (!user) return Astro.redirect("/sign-in")

interface Props {
  title?: string
  active?: "overview" | "keys" | "usage" | "settings"
}
const { title = "Dashboard · nikcli Inference", active = "overview" } = Astro.props

const navItems = [
  { id: "overview", href: "/dashboard", label: "Overview" },
  { id: "keys", href: "/dashboard/keys", label: "API Keys" },
  { id: "usage", href: "/dashboard/usage", label: "Usage" },
  { id: "settings", href: "/dashboard/settings", label: "Settings" },
]
---

<Base title={title}>
  <Nav />
  <div class="mx-auto grid w-full max-w-6xl gap-5 px-4 py-6 sm:px-6 md:grid-cols-[220px_1fr] md:gap-6 md:py-10">
    <aside class="app-panel h-fit p-2 text-sm md:sticky md:top-24">
      <div class="mb-2 rounded-[var(--radius-md)] border border-terminal-border/70 bg-terminal-bg/50 px-3 py-3">
        <p class="truncate text-sm font-semibold text-terminal-text">{user.name ?? user.email.split("@")[0]}</p>
        <p class="mt-0.5 truncate text-xs text-terminal-muted">{user.email}</p>
      </div>
      <nav class="-mx-1 flex gap-1 overflow-x-auto px-1 pb-1 md:mx-0 md:block md:space-y-1 md:overflow-visible md:px-0 md:pb-0" aria-label="Dashboard sections">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class={`flex min-h-10 shrink-0 items-center rounded-[var(--radius-md)] px-3 text-sm font-medium transition-colors md:w-full ${active === item.id ? "bg-terminal-accent/10 text-terminal-accent" : "text-terminal-muted hover:bg-surface-hover hover:text-terminal-text"}`}
          >
            {item.label}
          </a>
        ))
      }
      </nav>
      <div class="my-2 h-px bg-terminal-border/60"></div>
      <div class="-mx-1 flex gap-1 overflow-x-auto px-1 pb-1 md:mx-0 md:block md:space-y-1 md:overflow-visible md:px-0 md:pb-0">
        <a href="/docs" class="flex min-h-10 shrink-0 items-center rounded-[var(--radius-md)] px-3 text-sm font-medium text-terminal-muted transition-colors hover:bg-surface-hover hover:text-terminal-text md:w-full">
          Docs
        </a>
        <form action="/api/auth/sign-out" method="POST" class="shrink-0 md:w-full">
          <button type="submit" class="flex min-h-10 w-full items-center rounded-[var(--radius-md)] px-3 text-left text-sm font-medium text-terminal-muted transition-colors hover:bg-surface-hover hover:text-terminal-text">
          Sign out
          </button>
        </form>
      </div>
    </aside>
    <main id="main-content" class="min-w-0"><slot /></main>
  </div>
</Base>
