{
  "name": "@nikcli-ai/bench-tui",
  "version": "0.1.0",
  "type": "module",
  "description": "Visual benchmark dashboard for nikcli test suites",
  "main": "./src/index.ts",
  "bin": {
    "bench-tui": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.tsx",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "cd ../nikcli && bunx tsgo --noEmit -p ../bench-tui/tsconfig.json",
    "lint": "bun test --passWithNoTests"
  },
  "dependencies": {
    "@opentui/core": "0.1.95",
    "@opentui/solid": "0.1.95",
    "solid-js": "1.9.10"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "bun-types": "1.3.7"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  }
}
