{
  "name": "@nikcli-ai/bench-tui",
  "version": "1.206.0",
  "type": "module",
  "description": "Standalone test interface and benchmark dashboard for Bun packages",
  "main": "./src/index.ts",
  "bin": {
    "bench-tui": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.tsx",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.1.95",
    "@opentui/solid": "0.1.95",
    "solid-js": "1.9.10"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@typescript/native": "catalog:",
    "bun-types": "1.3.14"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  }
}
