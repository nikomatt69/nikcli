FROM oven/bun:1.3.10-debian AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash git ripgrep libgcc-s1 libstdc++6 openssh-server curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

FROM base AS build

COPY package.json bun.lock /app/
COPY patches /app/patches
COPY packages/nikcli/package.json /app/packages/nikcli/
COPY packages/script/package.json /app/packages/script/
COPY packages/util/package.json /app/packages/util/
COPY packages/sdk/js/package.json /app/packages/sdk/js/
COPY packages/remote/package.json /app/packages/remote/
COPY packages/plugin/package.json /app/packages/plugin/
COPY packages/companion/package.json /app/packages/companion/
COPY packages/slack/package.json /app/packages/slack/
COPY packages/studio/package.json /app/packages/studio/
COPY packages/studio/src /app/packages/studio/src
COPY github/package.json /app/github/

# Stub package.json for workspace packages not built in this image
RUN set -e; \
    for entry in \
      "packages/app:@nikcli-ai/app" \
      "packages/cloud:@nikcli-ai/cloud" \
      "packages/companion/ui:@nikcli-ai/companion-ui" \
      "packages/console/app:@nikcli-ai/console-app" \
      "packages/console/core:@nikcli-ai/console-core" \
      "packages/console/function:@nikcli-ai/console-function" \
      "packages/console/mail:@nikcli-ai/console-mail" \
      "packages/console/resource:@nikcli-ai/console-resource" \
      "packages/desktop:@nikcli-ai/desktop" \
      "packages/enterprise:@nikcli-ai/enterprise" \
      "packages/function:@nikcli-ai/function" \
      "packages/mobile:@nikcli-ai/mobile" \
      "packages/plugin/plugins/agent-memory:@nikcli-ai/plugin-agent-memory" \
      "packages/plugin/plugins/background-agents:@nikcli-ai/plugin-background-agents" \
      "packages/plugin/plugins/background:@nikcli-ai/plugin-background" \
      "packages/plugin/plugins/context-analysis:@nikcli-ai/plugin-context-analysis" \
      "packages/plugin/plugins/direnv:@nikcli-ai/plugin-direnv" \
      "packages/plugin/plugins/dynamic-context-pruning:@nikcli-ai/plugin-dynamic-context-pruning" \
      "packages/plugin/plugins/envsitter-guard:@nikcli-ai/plugin-envsitter-guard" \
      "packages/plugin/plugins/handoff:@nikcli-ai/plugin-handoff" \
      "packages/plugin/plugins/safety-net:@nikcli-ai/plugin-safety-net" \
      "packages/plugin/plugins/smart-title:@nikcli-ai/plugin-smart-title" \
      "packages/remote/web-client:@nikcli-ai/remote-client" \
      "packages/ui:@nikcli-ai/ui" \
      "packages/web:@nikcli-ai/web" \
      "packages/webrenderer:@opentui/webrenderer" \
    ; do \
      dir="${entry%%:*}"; name="${entry##*:}"; \
      mkdir -p "/app/$dir" && \
      printf '{"name":"%s","version":"0.0.0","private":true}\n' "$name" > "/app/$dir/package.json"; \
    done

RUN cd /app && bun install

COPY packages/nikcli /app/packages/nikcli
COPY packages/script /app/packages/script
COPY packages/util /app/packages/util
COPY packages/sdk/js /app/packages/sdk/js
COPY packages/remote /app/packages/remote
COPY packages/plugin /app/packages/plugin
COPY packages/companion /app/packages/companion
COPY packages/slack /app/packages/slack
COPY packages/studio /app/packages/studio
COPY github /app/github

ENV NIKCLI_CHANNEL=latest
ENV NIKCLI_VERSION=0.0.0-dev
RUN cd /app/packages/nikcli && bun run script/build.ts --single --skip-install

FROM base AS runtime

COPY --from=build /app/packages/nikcli/dist /tmp/nikcli-dist

ARG TARGETARCH
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        cp /tmp/nikcli-dist/nikcli-linux-arm64/bin/nikcli /usr/local/bin/nikcli; \
    else \
        cp /tmp/nikcli-dist/nikcli-linux-x64/bin/nikcli /usr/local/bin/nikcli; \
    fi && chmod +x /usr/local/bin/nikcli && rm -rf /tmp/nikcli-dist

RUN nikcli --version

RUN mkdir -p /var/run/sshd /data /data/config /data/state && \
    ssh-keygen -A && \
    chmod 0755 /var/run/sshd && \
    chmod 0644 /etc/ssh/ssh_host_rsa_key /etc/ssh/ssh_host_ecdsa_key /etc/ssh/ssh_host_ed25519_key

ENV PORT=4096
ENV XDG_DATA_HOME=/data
ENV XDG_CONFIG_HOME=/data/config
ENV XDG_STATE_HOME=/data/state
ENV NIKCLI_SERVER_USERNAME=nikcli
ENV NIKCLI_SERVER_SSH_ENABLED=true
ENV NIKCLI_SERVER_SSH_PORT=2222
ENV NIKCLI_SERVER_SSH_HOST=0.0.0.0
# Comma-separated list of extra origins to allow for CORS (e.g. your web domain)
# Set NIKCLI_SERVER_CORS_ORIGINS=https://yourdomain.com in Railway environment variables

EXPOSE 4096 2222

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -s -o /dev/null "http://127.0.0.1:${PORT:-4096}/" || exit 1

CMD ["sh", "-c", "mkdir -p /data/nikcli /data/config /data/state && if [ -n \"$NIKCLI_AUTH_JSON\" ]; then printf '%s' \"$NIKCLI_AUTH_JSON\" | base64 -d > /data/nikcli/auth.json; fi && if [ -n \"$NIKCLI_CONNECTORS_AUTH_JSON\" ]; then printf '%s' \"$NIKCLI_CONNECTORS_AUTH_JSON\" | base64 -d > /data/nikcli/connectors-auth.json; fi && exec nikcli mobile serve --hostname 0.0.0.0 --port ${PORT:-4096} --pair --public-url https://${RAILWAY_PUBLIC_DOMAIN:-nikcli-mobile-production.up.railway.app}"]
