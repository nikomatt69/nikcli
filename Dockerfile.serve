FROM oven/bun:1.3.14-debian

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash git curl ca-certificates libgcc-s1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json bun.lock ./
COPY patches /app/patches
COPY github/package.json /app/github/
RUN mkdir -p /app/packages && \
    for dir in \
      app cloud companion console/app console/core console/function \
      console/mail console/resource desktop enterprise function \
      http-recorder inference inference-dashboard llm mobile nikcli \
      plugin remote remote/web-client script sdk/js slack ui util \
      web webrenderer companion/ui \
    ; do \
      mkdir -p "/app/packages/$dir"; \
    done
COPY packages/nikcli/package.json /app/packages/nikcli/
COPY packages/script/package.json /app/packages/script/
COPY packages/util/package.json /app/packages/util/
COPY packages/sdk/js/package.json /app/packages/sdk/js/
COPY packages/remote/package.json /app/packages/remote/
COPY packages/plugin/package.json /app/packages/plugin/
COPY packages/companion/package.json /app/packages/companion/
COPY packages/slack/package.json /app/packages/slack/
COPY packages/llm/package.json /app/packages/llm/
COPY packages/http-recorder/package.json /app/packages/http-recorder/
COPY packages/app/package.json /app/packages/app/
COPY packages/cloud/package.json /app/packages/cloud/
COPY packages/console/app/package.json /app/packages/console/app/
COPY packages/console/core/package.json /app/packages/console/core/
COPY packages/console/function/package.json /app/packages/console/function/
COPY packages/console/mail/package.json /app/packages/console/mail/
COPY packages/console/resource/package.json /app/packages/console/resource/
COPY packages/enterprise/package.json /app/packages/enterprise/
COPY packages/ui/package.json /app/packages/ui/
COPY packages/web/package.json /app/packages/web/
COPY packages/desktop/package.json /app/packages/desktop/
COPY packages/function/package.json /app/packages/function/
COPY packages/mobile/package.json /app/packages/mobile/
COPY packages/webrenderer/package.json /app/packages/webrenderer/
COPY packages/inference/package.json /app/packages/inference/
COPY packages/inference-dashboard/package.json /app/packages/inference-dashboard/
COPY packages/companion/ui/package.json /app/packages/companion/ui/
COPY packages/remote/web-client/package.json /app/packages/remote/web-client/

RUN bun install

COPY . .

RUN mkdir -p /data /data/nikcli /data/cache /data/config /data/state

COPY script/entrypoint.serve.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PORT=4096
ENV XDG_DATA_HOME=/data
ENV XDG_CACHE_HOME=/data/cache
ENV XDG_CONFIG_HOME=/data/config
ENV XDG_STATE_HOME=/data/state
ENV NIKCLI_SERVER_USERNAME=nikcli
ENV NIKCLI_SERVER_PASSWORD=dev123

EXPOSE 4096

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -s -o /dev/null "http://127.0.0.1:${PORT:-4096}/" || exit 1

ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
